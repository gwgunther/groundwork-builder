---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'



const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Blog', href: '/blog' },
  { label: 'Schedule', href: '/schedule' },
]

const socialLinks = [
  {
    label: 'Yelp',
    href: 'http://www.yelp.com/biz/pediatric-dental-specialists-long-beach',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M20.16 12.73l-4.38-1.44a.87.87 0 0 0-1.04.53.88.88 0 0 0 .28 1.03l3.86 2.85c.34.25.8.2 1.09-.1a3.74 3.74 0 0 0 .19-2.87zm-2.47 4.08l-4.01-1.97a.87.87 0 0 0-1.16.38.88.88 0 0 0 .17 1.07l3.27 3.17c.29.28.74.28 1.05.02a5.3 5.3 0 0 0 .68-2.67zm-5.2-5.58V5.06a.88.88 0 0 0-.87-.88C9.17 4.18 6 6.77 6 11.25c0 .29.01.57.04.85l4.38-1.44c.47-.16.72-.66.07-.43zm-.88 6.7l-.51-4.38a.87.87 0 0 0-.96-.76.88.88 0 0 0-.77.7l-.77 4.38a.88.88 0 0 0 .56 1.01 6.3 6.3 0 0 0 2.45 0 .88.88 0 0 0 0-1.95zm-4.5-5.93a.88.88 0 0 0-1.1-.56 3.74 3.74 0 0 0-.96 2.71.88.88 0 0 0 1.03.64l4.38-1.44c.47-.16.47-.88 0-1.04l-3.35-1.31z"/></svg>`,
  },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/PDSLongBeach',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88V14.89H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99C18.34 21.13 22 16.99 22 12z"/></svg>`,
  },
]

const currentYear = new Date().getFullYear()
---

<footer class="w-full bg-neutral-dark text-white">
  <!-- Editorial split: large name left, details right -->
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">

      <!-- Left column: practice identity -->
      <div class="flex flex-col gap-6">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary">
          Long Beach, CA
        </p>
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-white">
          {site.name}
        </h2>
        <p class="text-base leading-relaxed text-neutral-300 max-w-sm">
          Compassionate pediatric dental care in Long Beach — where little smiles get the attention they deserve.
        </p>

        <!-- Social links -->
        <div class="flex items-center gap-4 mt-2">
          {socialLinks.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit us on ${link.label}`}
              class="inline-flex items-center justify-center w-10 h-10 rounded-2xl border border-white/20 text-neutral-300 hover:border-brand-primary hover:text-brand-primary transition-all duration-200"
            >
              <Fragment set:html={link.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Right column: address, hours, nav -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">

        <!-- Contact & Address -->
        <div class="flex flex-col gap-4">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary">
            Contact
          </p>
          <address class="not-italic flex flex-col gap-2">
            <span class="text-base leading-relaxed text-neutral-300">
              {addr.street}<br />
              {addr.city && addr.state && addr.zip
                ? `${addr.city}, ${addr.state} ${addr.zip}`
                : addr.city}
            </span>
            <a
              href={`tel:${site.phone.replace(/\D/g, '')}`}
              class="text-base font-semibold text-white hover:text-brand-primary transition-all duration-200 min-h-[44px] inline-flex items-center"
            >
              {site.phone}
            </a>
          </address>
        </div>

        <!-- Navigation -->
        <div class="flex flex-col gap-4">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary">
            Navigate
          </p>
          <nav aria-label="Footer navigation">
            <ul class="flex flex-col gap-3">
              {navLinks.map(link => (
                <li>
                  <a
                    href={link.href}
                    class="text-base leading-relaxed text-neutral-300 hover:text-white transition-all duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-neutral-400 text-center sm:text-left">
        &copy; {currentYear} {site.name}. All rights reserved.
      </p>
      <p class="text-sm text-neutral-500 text-center sm:text-right">
        Serving families across Long Beach, CA
      </p>
    </div>
  </div>
</footer>