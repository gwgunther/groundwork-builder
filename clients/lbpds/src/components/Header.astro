---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'


---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-100">
  <nav class="max-w-7xl mx-auto px-6 flex items-center justify-between h-16 md:h-20">

    <!-- Logo / Practice Name -->
    <a
      href="/"
      class="font-serif text-lg md:text-xl font-bold text-neutral-dark leading-tight hover:opacity-80 transition-all duration-200 whitespace-nowrap"
      aria-label="Pediatric Dental Specialists — Home"
    >
      Pediatric Dental<br class="hidden sm:block md:hidden" /> Specialists
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">

      <!-- Meet Dr. Cortez -->
      <a
        href="/about"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      >
        Meet Dr. Cortez
      </a>

      <!-- Services Dropdown -->
      <div class="relative group">
        <button
          class="flex items-center gap-1 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg
            class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Panel — pt-2 bridges hover gap, no mt -->
        <div class="absolute top-full left-0 pt-2 w-64 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 z-50">
          <div class="bg-white shadow-md rounded-2xl p-3 flex flex-col gap-0.5">
            <a
              href="/services/braces"
              class="text-sm text-neutral-700 font-medium px-4 py-2.5 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-150 whitespace-nowrap"
            >
              Braces
            </a>
            <a
              href="/services/dental-care-for-your-baby"
              class="text-sm text-neutral-700 font-medium px-4 py-2.5 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-150 whitespace-nowrap"
            >
              Dental Care For Your Baby
            </a>
            <a
              href="/services/dental-exams-and-cleanings"
              class="text-sm text-neutral-700 font-medium px-4 py-2.5 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-150 whitespace-nowrap"
            >
              Dental Exams and Cleanings
            </a>
            <a
              href="/services/digit-sucking-pacifier-use"
              class="text-sm text-neutral-700 font-medium px-4 py-2.5 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-150 whitespace-nowrap"
            >
              Digit Sucking / Pacifier Use
            </a>
            <a
              href="/services/emergencies"
              class="text-sm text-neutral-700 font-medium px-4 py-2.5 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-150 whitespace-nowrap"
            >
              Emergencies
            </a>
            <a
              href="/services/first-dental-visit"
              class="text-sm text-neutral-700 font-medium px-4 py-2.5 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-150 whitespace-nowrap"
            >
              First Dental Visit
            </a>
            <div class="mt-1 pt-2 border-t border-neutral-100">
              <a
                href="/services"
                class="text-sm text-brand-primary font-semibold px-4 py-2.5 rounded-xl hover:bg-brand-primary/8 transition-all duration-150 flex items-center gap-1 whitespace-nowrap"
              >
                All Services
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M2 8a.75.75 0 01.75-.75h8.69L8.22 4.03a.75.75 0 011.06-1.06l4.25 4.25a.75.75 0 010 1.06L9.28 12.53a.75.75 0 01-1.06-1.06l3.22-3.22H2.75A.75.75 0 012 8z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Phone -->
      <a
        href="tel:+15623771375"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap tabular-nums"
        aria-label="Call us at (562) 377-1375"
      >
        (562) 377-1375
      </a>

      <!-- Book Appointment CTA -->
      <a
        href="/schedule"
        class="inline-block bg-brand-primary text-white font-semibold px-8 py-4 rounded-2xl transition-all duration-200 text-center hover:opacity-90 ml-6 whitespace-nowrap text-sm"
      >
        Book Appointment
      </a>

    </div>

    <!-- Mobile Controls -->
    <div class="flex md:hidden items-center gap-4">
      <a
        href="tel:+15623771375"
        class="flex items-center justify-center w-11 h-11 rounded-xl text-brand-primary hover:bg-brand-primary/8 transition-all duration-200"
        aria-label="Call (562) 377-1375"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.99 2.18 2 2 0 012.97 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
      </a>

      <!-- Mobile Menu Toggle (Alpine.js) -->
      <button
        x-data
        @click="$dispatch('toggle-mobile-nav')"
        class="flex items-center justify-center w-11 h-11 rounded-xl text-neutral-dark hover:bg-neutral-100 transition-all duration-200"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

  </nav>

  <!-- Mobile Drawer (Alpine.js) -->
  <div
    x-data="{ open: false }"
    @toggle-mobile-nav.window="open = !open"
    class="md:hidden"
  >
    <div
      x-show="open"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-2"
      class="bg-white border-t border-neutral-100 px-6 pb-8 pt-4 flex flex-col gap-1"
    >

      <a
        href="/about"
        class="text-base font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 py-3 border-b border-neutral-50 whitespace-nowrap"
      >
        Meet Dr. Cortez
      </a>

      <!-- Mobile Services Accordion -->
      <div x-data="{ servicesOpen: false }">
        <button
          @click="servicesOpen = !servicesOpen"
          class="w-full flex items-center justify-between text-base font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 py-3 border-b border-neutral-50"
          :aria-expanded="servicesOpen"
        >
          <span>Services</span>
          <svg
            class="w-4 h-4 transition-transform duration-200"
            :class="{ 'rotate-180': servicesOpen }"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <div
          x-show="servicesOpen"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          class="flex flex-col gap-0.5 pt-2 pb-2 pl-4"
        >
          <a href="/services/braces" class="text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-150 py-2">Braces</a>
          <a href="/services/dental-care-for-your-baby" class="text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-150 py-2">Dental Care For Your Baby</a>
          <a href="/services/dental-exams-and-cleanings" class="text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-150 py-2">Dental Exams and Cleanings</a>
          <a href="/services/digit-sucking-pacifier-use" class="text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-150 py-2">Digit Sucking / Pacifier Use</a>
          <a href="/services/emergencies" class="text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-150 py-2">Emergencies</a>
          <a href="/services/first-dental-visit" class="text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-150 py-2">First Dental Visit</a>
          <a href="/services" class="text-sm font-semibold text-brand-primary hover:underline transition-all duration-150 py-2 flex items-center gap-1">
            All Services
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M2 8a.75.75 0 01.75-.75h8.69L8.22 4.03a.75.75 0 011.06-1.06l4.25 4.25a.75.75 0 010 1.06L9.28 12.53a.75.75 0 01-1.06-1.06l3.22-3.22H2.75A.75.75 0 012 8z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Mobile Phone -->
      <a
        href="tel:+15623771375"
        class="text-base font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 py-3 border-b border-neutral-50 tabular-nums whitespace-nowrap"
        aria-label="Call (562) 377-1375"
      >
        (562) 377-1375
      </a>

      <!-- Mobile CTA -->
      <div class="pt-4">
        <a
          href="/schedule"
          class="inline-block bg-brand-primary text-white font-semibold px-8 py-4 rounded-2xl transition-all duration-200 text-center hover:opacity-90 w-full whitespace-nowrap"
        >
          Book Appointment
        </a>
      </div>

    </div>
  </div>

</header>