---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import { site, localBusinessSchema } from '../config/site';

// TODO: Customize services for the practice
const services = [
  { name: 'Braces', slug: 'braces', href: '/services/braces', desc: 'Whether your child needs traditional braces or you\'re exploring other options, we\'re here to help you find the right fit' },
  { name: 'Dental Care For Your Baby', slug: 'dental-care-for-your-baby', href: '/services/dental-care-for-your-baby', desc: 'Starting your child off with good dental care can help protect their teeth for decades to come.' },
  { name: 'Dental Exams and Cleanings', slug: 'dental-exams-and-cleanings', href: '/services/dental-exams-and-cleanings', desc: 'Regular checkups and cleanings are one of the best things you can do for your child\'s smile. We make visits as comfortab' },
  { name: 'Digit Sucking/Pacifier Use', slug: 'digit-sucking-pacifier-use', href: '/services/digit-sucking-pacifier-use', desc: 'Sucking is quite normal in babies and young children.' },
  { name: 'Emergencies', slug: 'emergencies', href: '/services/emergencies', desc: 'Dental emergencies can be stressful — especially when it\'s your child. Whether your little one has a toothache, an injur' },
  { name: 'First Dental Visit', slug: 'first-dental-visit', href: '/services/first-dental-visit', desc: 'When should your child\'s first dental visit be?' },
  { name: 'Fluoride', slug: 'fluoride', href: '/services/fluoride', desc: 'Fluoride is one of the most effective tools we have for protecting kids\' teeth from cavities. It works by strengthening ' },
  { name: 'Gum Disease Treatment', slug: 'gum-disease-treatment', href: '/services/gum-disease-treatment', desc: 'Gum disease isn\'t just an adult concern — kids and teens can develop it too. It starts as an infection of the gums surro' },
  { name: 'Oral Cancer Screening', slug: 'oral-cancer-screening', href: '/services/oral-cancer-screening', desc: 'Oral cancer screenings are a routine part of a thorough dental exam. While oral cancer is less common in children, early' },
  { name: 'Orthodontic Emergency Care', slug: 'orthodontic-emergency-care', href: '/services/orthodontic-emergency-care', desc: 'We want our patients to be informed of problems that may occur, and understand how to solve them, at least temporarily, until it is possible to return' },
  { name: 'Orthodontics', slug: 'orthodontics', href: '/services/orthodontics', desc: 'We offer orthodontic treatment for children and teens.' },
  { name: 'Preventive Care', slug: 'preventive-care', href: '/services/preventive-care', desc: 'The best dental care is the kind that keeps problems from happening in the first place. For kids, that means building he' },
  { name: 'Retention', slug: 'retention', href: '/services/retention', desc: 'Finishing orthodontic treatment is a big moment — and wearing a retainer is what keeps that result lasting. We\'ll make s' },
  { name: 'Sealants', slug: 'sealants', href: '/services/sealants', desc: 'Sometimes brushing is not enough, especially when it comes to those hard-to-reach spots in your mouth.' },
  { name: 'Silver Diamine Fluoride', slug: 'silver-diamine-fluoride', href: '/services/silver-diamine-fluoride', desc: 'Silver Diamine Fluoride may slow or stop tooth decay.' },
];
---

<BaseLayout
  title={`Services — ${site.name}`}
  description={`Comprehensive dental services at ${site.name}. General dentistry, cosmetic treatments, dental implants, and restorations. Call ${site.phone}.`}
  schema={localBusinessSchema}
>
  <section class="bg-surface-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="section-heading mb-6">Our Services</h1>
        <p class="text-lg text-neutral-mid leading-relaxed">
          From routine checkups to advanced restorations, we provide a full range of dental services to keep your smile healthy and beautiful.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((service) => (
          <a href={service.href || `/services/${service.slug}`} class="card hover:border-brand-primary/30 transition-colors group">
            <h2 class="font-serif text-xl font-semibold text-neutral-dark mb-2 group-hover:text-brand-primary transition-colors">{service.name}</h2>
            <p class="text-neutral-mid">{service.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CTABlock phone={site.phone} />
    </div>
  </section>
</BaseLayout>
