---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Orthodontics",
  "description": "We offer orthodontic treatment for children and teens.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Pediatric Dental Specialists",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Orthodontics Long Beach | ${site.name}`}
  description="We offer orthodontic treatment for children and teens."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Orthodontics
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      We offer orthodontic treatment for children and teens.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">A straight smile is about more than looks — it's about how your child bites, chews, and feels about their teeth every day. We offer orthodontic treatment for children and teens right here in our Long Beach office, so your family doesn't have to go anywhere else. From your child's first orthodontic evaluation to the day they show off their finished smile, we're with you every step of the way.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule an Orthodontic Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
