---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Sealants",
  "description": "Sometimes brushing is not enough, especially when it comes to those hard-to-reach spots in your mouth.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Pediatric Dental Specialists",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Sealants Long Beach | ${site.name}`}
  description="Sometimes brushing is not enough, especially when it comes to those hard-to-reach spots in your mouth."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Sealants
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Sometimes brushing is not enough, especially when it comes to those hard-to-reach spots in your mouth.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Sometimes brushing isn't enough — especially when it comes to those hard-to-reach spots in the back of your child's mouth. Sealants are a simple, painless way to protect the grooves in your child's molars where cavities most commonly form. We apply a thin protective coating that acts as a barrier against food and bacteria, giving your child's teeth an extra layer of defense between checkups.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Ask About Sealants at the Next Visit</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
