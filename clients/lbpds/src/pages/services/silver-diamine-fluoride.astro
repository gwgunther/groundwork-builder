---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Silver Diamine Fluoride (SDF)",
  "description": "Silver Diamine Fluoride may slow or stop tooth decay.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Pediatric Dental Specialists",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Silver Diamine Fluoride Long Beach | ${site.name}`}
  description="Silver Diamine Fluoride may slow or stop tooth decay."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Silver Diamine Fluoride (SDF)
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Silver Diamine Fluoride may slow or stop tooth decay.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Silver Diamine Fluoride (SDF) is a non-invasive treatment that may slow or stop tooth decay — which makes it a great option for young children or kids who need a little more time before they're ready for traditional cavity treatment. It's applied quickly and painlessly, and it can make a real difference in protecting a tooth while we figure out the best long-term plan. We're happy to talk through whether SDF is right for your child at your next visit.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Ask Us About SDF</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
