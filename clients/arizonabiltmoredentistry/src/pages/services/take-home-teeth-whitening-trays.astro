---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Take-Home Teeth Whitening Trays",
  "description": "Custom-made whitening trays and professional-strength gel for at-home teeth whitening, created from impressions taken in-office.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Take-Home Teeth Whitening Trays Phoenix | ${site.name}`}
  description="Custom-made whitening trays and professional-strength gel for at-home teeth whitening, created from impressions taken in-office."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Take-Home Teeth Whitening Trays
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Custom-made whitening trays and professional-strength gel for at-home teeth whitening, created from impressions taken in-office.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">For patients who prefer to whiten on their own schedule, Arizona Biltmore Dentistry provides custom take-home whitening trays. Unlike over-the-counter strips or generic trays, our take-home kits are made from precise impressions of your teeth — ensuring even contact with the whitening gel and consistent results. Professional-grade whitening gel is included, allowing you to achieve a noticeably brighter smile from home.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Reserve Your Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Perfect for avoiding any hassle of office visits.</p>
      <p>Impressions of the teeth and mouth are taken in-office and sent to the lab to have custom whitening trays created.</p>
      <p>Once trays are ready, patient comes in for a quick fitting and to go over the recommended whitening schedule.</p>
      <p>Professional-strength gel is included for use at home.</p>
    </div>
  </section>
</BaseLayout>
