---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "3Shape Digital Scanner",
  "description": "3shape digital intraoral scanner for precise digital impressions.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`3shape Digital Scanner Phoenix | ${site.name}`}
  description="3shape digital intraoral scanner for precise digital impressions."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      3Shape Digital Scanner
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      3shape digital intraoral scanner for precise digital impressions.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Arizona Biltmore Dentistry uses the 3Shape digital scanner to capture precise, three-dimensional impressions of your teeth and surrounding structures — without traditional impression materials. The result is a more comfortable experience and a more accurate foundation for crowns, aligners, implant restorations, and other treatments that depend on exact fit.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Reserve Your Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Listed as an advanced technology available at Arizona Biltmore Dentistry.</p>
    </div>
  </section>
</BaseLayout>
