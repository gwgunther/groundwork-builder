---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Laser Gum Therapy (LANAP®)",
  "description": "Advanced laser-assisted new attachment procedure (LANAP®) for treating gum disease.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Laser Gum Therapy (LANAP®) Phoenix | ${site.name}`}
  description="Advanced laser-assisted new attachment procedure (LANAP®) for treating gum disease."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Laser Gum Therapy (LANAP®)
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Advanced laser-assisted new attachment procedure (LANAP®) for treating gum disease.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">LANAP — Laser-Assisted New Attachment Procedure — is a minimally invasive approach to treating periodontal disease. Using a specific laser wavelength, the procedure targets and removes diseased tissue while preserving healthy gum and bone. At Arizona Biltmore Dentistry, LANAP offers patients an effective alternative to conventional gum surgery, with less discomfort and a faster recovery.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>LANAP® is listed as one of the advanced technologies available at the practice.</p>
      <p>Laser gum therapy is referenced as part of the advanced technology used at Arizona Biltmore Dentistry.</p>
    </div>
  </section>
</BaseLayout>
