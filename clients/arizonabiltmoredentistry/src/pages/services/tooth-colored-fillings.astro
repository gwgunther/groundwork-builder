---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Tooth-Colored Fillings",
  "description": "Tooth-colored (composite) fillings used to restore teeth affected by decay, available for both pediatric and adult patients.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Tooth-Colored Fillings Phoenix | ${site.name}`}
  description="Tooth-colored (composite) fillings used to restore teeth affected by decay, available for both pediatric and adult patients."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Tooth-Colored Fillings
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Tooth-colored (composite) fillings used to restore teeth affected by decay, available for both pediatric and adult patients.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Tooth-colored fillings use composite resin matched to the shade of your natural tooth — restoring a decayed or damaged area without the metallic appearance of traditional amalgam. At Arizona Biltmore Dentistry, composite fillings are placed with care for both function and aesthetics, blending into the surrounding tooth so that the restoration is virtually invisible.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Reserve Your Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Listed as both a pediatric service and a restorative dentistry service.</p>
      <p>SonicFill™ technology is referenced sitewide as an advanced technology used at the practice.</p>
    </div>
  </section>
</BaseLayout>
