---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Digital X-Rays & CBCT",
  "description": "Digital X-rays and cone beam computed tomography (CBCT) imaging for accurate diagnosis and treatment planning.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Digital X-Rays & CBCT Phoenix | ${site.name}`}
  description="Digital X-rays and cone beam computed tomography (CBCT) imaging for accurate diagnosis and treatment planning."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Digital X-Rays &amp; CBCT
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Digital X-rays and cone beam computed tomography (CBCT) imaging for accurate diagnosis and treatment planning.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Arizona Biltmore Dentistry uses digital X-rays and cone beam computed tomography (CBCT) to capture detailed, three-dimensional images of teeth, bone, nerves, and surrounding structures. Digital imaging reduces radiation exposure compared to conventional film X-rays, and CBCT provides the precise anatomical detail required for implant planning, guided surgery, and complex restorative cases.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Reserve Your Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Digital X-rays are taken of the teeth and jaw as part of standard diagnostic procedures.</p>
      <p>3-D images of teeth, jaws, and mouth are taken during cosmetic consultations.</p>
      <p>CBCT is listed as an advanced technology at the practice.</p>
      <p>Used during root canal therapy to pinpoint the location of the problem and to confirm complete removal of infected tissue.</p>
    </div>
  </section>
</BaseLayout>
