---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Family Dentistry in Phoenix, AZ",
  "description": "Comprehensive dental care for every member of the family, focused on building good oral health habits and lifelong dental hygiene.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Family Dentistry Phoenix | ${site.name}`}
  description="Comprehensive dental care for every member of the family, focused on building good oral health habits and lifelong dental hygiene."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Family Dentistry in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Comprehensive dental care for every member of the family, focused on building good oral health habits and lifelong dental hygiene.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Dr. Aaron Jeziorski and the team at Arizona Biltmore Dentistry provide preventive and restorative dental care for patients of all ages. From a child's first exam to adult restorations, the practice is structured to serve every member of your family under one roof — with consistent, attentive care at each stage of life.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Reserve Your Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>According to the American Academy of Pediatric Dentistry, kids should visit a dentist when their first tooth comes in or no later than their first birthday.</p>
      <p>Serves patients of all ages.</p>
    </div>
  </section>
</BaseLayout>
