---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Restorative Dentistry in Phoenix, AZ",
  "description": "Arizona Biltmore Dentistry provides restorative dentistry solutions in Phoenix, AZ — from dentures to crowns, we'll help you fill in the gaps.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Restorative Dentistry Phoenix | ${site.name}`}
  description="Arizona Biltmore Dentistry provides restorative dentistry solutions in Phoenix, AZ — from dentures to crowns, we'll help you fill in the gaps."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Restorative Dentistry in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Arizona Biltmore Dentistry provides restorative dentistry solutions in Phoenix, AZ — from dentures to crowns, we'll help you fill in the gaps.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">If you're living with broken, severely discolored, missing, or infected teeth, restorative dentistry can return you to the smile you know. At Arizona Biltmore Dentistry, restorative care spans the full range of treatment — from crowns and root canals to start-to-finish implant placement and full-arch reconstructions — all completed in our Phoenix office.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Restorative treatments include tooth-colored fillings, dental crowns, bridges, full &amp; partial dentures, start-to-finish dental implants, tooth extractions, and bone grafts.</p>
      <p>Post-op care instructions are available for restorations.</p>
    </div>
  </section>
</BaseLayout>
