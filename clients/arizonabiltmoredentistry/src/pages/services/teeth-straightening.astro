---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Teeth Straightening in Phoenix, AZ",
  "description": "Teeth straightening services including clear aligners, ClearCorrect, and CandidPro offered at Arizona Biltmore Dentistry.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Teeth Straightening Phoenix | ${site.name}`}
  description="Teeth straightening services including clear aligners, ClearCorrect, and CandidPro offered at Arizona Biltmore Dentistry."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Teeth Straightening in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Teeth straightening services including clear aligners, ClearCorrect, and CandidPro offered at Arizona Biltmore Dentistry.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Straighter teeth are easier to clean, function more comfortably, and make a meaningful difference in how you feel about your smile. At Arizona Biltmore Dentistry, teeth straightening is accomplished through clear aligner systems — Invisalign, ClearCorrect, and CandidPro — planned digitally and delivered without traditional metal braces. Treatment is available for adults and teens.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Options include clear aligners, ClearCorrect, and CandidPro.</p>
      <p>Listed as a primary service category in the navigation.</p>
    </div>
  </section>
</BaseLayout>
