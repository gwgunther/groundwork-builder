---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Traditional Dentures in Phoenix, AZ",
  "description": "Conventional removable oral prostheses made of gum-colored acrylic and false teeth for patients missing multiple or all teeth.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Traditional Dentures Phoenix | ${site.name}`}
  description="Conventional removable oral prostheses made of gum-colored acrylic and false teeth for patients missing multiple or all teeth."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Traditional Dentures in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Conventional removable oral prostheses made of gum-colored acrylic and false teeth for patients missing multiple or all teeth.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">At Arizona Biltmore Dentistry, we offer fully customized traditional dentures for patients who have lost most or all of their teeth. Conventional full dentures rest on the gum tissue and are removed for cleaning; partial dentures clasp to remaining natural teeth to fill gaps in the arch. Both are crafted to fit comfortably and to restore a complete, natural-looking smile.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Made of gum-colored acrylic and false teeth.</p>
      <p>Bottom arch dentures lay comfortably in place on the floor of the mouth.</p>
      <p>Top arch dentures use a dental adhesive to stay in place.</p>
      <p>Available in both full and partial options.</p>
      <p>Traditional implants can take anywhere from six months to a year to heal.</p>
    </div>
  </section>
</BaseLayout>
