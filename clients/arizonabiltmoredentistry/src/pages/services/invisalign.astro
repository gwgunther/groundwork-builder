---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Invisalign in Phoenix, AZ",
  "description": "Invisalign clear aligner treatment, referenced in a current patient special offering $1,000 off.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Invisalign Phoenix | ${site.name}`}
  description="Invisalign clear aligner treatment, referenced in a current patient special offering \$1,000 off."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Invisalign in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Invisalign clear aligner treatment, referenced in a current patient special offering $1,000 off.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Invisalign is a clear aligner system that uses a series of custom, removable trays to move teeth gradually into alignment — without metal brackets or wires. At Arizona Biltmore Dentistry, Invisalign is available for adults and teens seeking a discreet, comfortable path to a straighter smile. Treatment is digitally mapped in advance, and trays are changed out at home on a prescribed schedule.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>$1,000 off Invisalign is offered as a current patient special.</p>
      <p>Limited time offer.</p>
    </div>
  </section>
</BaseLayout>
