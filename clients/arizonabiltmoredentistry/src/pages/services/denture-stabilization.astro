---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Denture Stabilization",
  "description": "Implant-based stabilization of existing dentures to prevent slipping and improve comfort.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Denture Stabilization Phoenix | ${site.name}`}
  description="Implant-based stabilization of existing dentures to prevent slipping and improve comfort."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Denture Stabilization
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Implant-based stabilization of existing dentures to prevent slipping and improve comfort.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Loose or ill-fitting dentures can affect comfort, confidence, and the ability to eat and speak freely. Denture stabilization uses dental implants to anchor an existing or new denture firmly in place — eliminating movement and restoring the security of a fixed restoration. At Arizona Biltmore Dentistry, stabilization is planned as part of a comprehensive implant consultation, with options tailored to the patient's anatomy and goals.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Listed as a type of dental implant service on the dental implants page.</p>
    </div>
  </section>
</BaseLayout>
