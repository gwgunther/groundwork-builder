---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Sedation Dentistry in Phoenix, AZ",
  "description": "Sedation options to help patients stay comfortable and relaxed during dental procedures.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Sedation Dentistry Phoenix | ${site.name}`}
  description="Sedation options to help patients stay comfortable and relaxed during dental procedures."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Sedation Dentistry in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Sedation options to help patients stay comfortable and relaxed during dental procedures.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">For patients who experience dental anxiety, have had difficult appointments in the past, or are facing longer procedures, sedation dentistry offers a calmer, more manageable experience. At Arizona Biltmore Dentistry, sedation options are discussed during your consultation so that every patient — regardless of their history with dental care — can receive the treatment they need in comfort.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Nitrous oxide is available to help patients relax during root canal therapy.</p>
      <p>Sedation options are offered to help patients stay comfortable throughout procedures.</p>
      <p>Post-op care instructions are available for sedation procedures.</p>
      <p>Sedation dentistry is listed as a separate service in the navigation.</p>
    </div>
  </section>
</BaseLayout>
