---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Cosmetic Dentist in Phoenix, AZ",
  "description": "From teeth whitening to veneers, we can help you learn to love your smile again.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Cosmetic Dentistry Phoenix | ${site.name}`}
  description="From teeth whitening to veneers, we can help you learn to love your smile again."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Cosmetic Dentist in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      From teeth whitening to veneers, we can help you learn to love your smile again.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Smile imperfections take many forms, and they can affect confidence, relationships, and how you carry yourself each day. At Arizona Biltmore Dentistry, cosmetic care is approached with both artistry and clinical precision — from subtle improvements like whitening and bonding to comprehensive transformations involving veneers, aligners, and full smile makeovers. A consultation with Dr. Jeziorski begins with a thorough examination and a candid conversation about what you'd like to change.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Services include dental bonding, dental implants, dentures, orthodontics using ClearCorrect &amp; clear aligners, smile makeovers, teeth whitening, and veneers &amp; Lumineers.</p>
      <p>Treats smile imperfections including teeth overcrowding, missing teeth, excessive teeth gapping, cracked or broken teeth, stained/yellowed/discolored teeth, and noticeable metallic restorations.</p>
      <p>Digital X-rays and 3-D images of teeth, jaws, and mouth are taken during the initial exam.</p>
      <p>Detailed dental impressions may also be taken during the initial exam.</p>
      <p>A customized plan of treatment is devised and fully explained to the patient following the initial smile assessment.</p>
    </div>
  </section>
</BaseLayout>
