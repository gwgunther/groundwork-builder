---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Complete Phoenix Dental Care",
  "description": "Our team at Arizona Biltmore Dentistry strives to meet all our patients' dental needs — from routine exams to complex smile makeovers.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`General Dentistry Phoenix | ${site.name}`}
  description="Our team at Arizona Biltmore Dentistry strives to meet all our patients' dental needs — from routine exams to complex smile makeovers."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Complete Phoenix Dental Care
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Our team at Arizona Biltmore Dentistry strives to meet all our patients' dental needs — from routine exams to complex smile makeovers.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">We are proud to serve our community and provide the people of Phoenix with dental care that meets all their smile needs. From routine appointments to complex restorations, our team can take care of most everything in one place — preventive cleanings, fillings, crowns, implants, orthodontics, and more. General dentistry at Arizona Biltmore Dentistry is the foundation of everything else we offer.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Reserve Your Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Services are designed to meet and exceed the needs of patients of all ages.</p>
      <p>Advanced technology includes digital X-rays and laser gum therapy.</p>
      <p>Patient amenities include WiFi and comfortable pillows.</p>
    </div>
  </section>
</BaseLayout>
