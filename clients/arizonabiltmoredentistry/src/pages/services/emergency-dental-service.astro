---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Emergency Dental Care in Phoenix",
  "description": "Emergency dental care for urgent dental issues, with a $99 emergency exam offer.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Emergency Dental Service Phoenix | ${site.name}`}
  description="Emergency dental care for urgent dental issues, with a \$99 emergency exam offer."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Emergency Dental Care in Phoenix
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Emergency dental care for urgent dental issues, with a $99 emergency exam offer.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">When a dental emergency arises — a sudden infection, a broken tooth, or severe pain — Arizona Biltmore Dentistry is available to see you promptly. The practice offers same-day emergency appointments, and the team's first priority upon your arrival is your comfort. If you are in pain, call the practice directly.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Call (602) 957-8200</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>$99 Emergency Exam is offered.</p>
      <p>Post-op care instructions are available for emergency/extraction and implant procedures.</p>
    </div>
  </section>
</BaseLayout>
