---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Dental Crowns",
  "description": "Dental crowns to restore damaged, weakened, or post-root-canal teeth, available for both pediatric and adult patients.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Crowns Phoenix | ${site.name}`}
  description="Dental crowns to restore damaged, weakened, or post-root-canal teeth, available for both pediatric and adult patients."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Dental Crowns
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Dental crowns to restore damaged, weakened, or post-root-canal teeth, available for both pediatric and adult patients.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">A dental crown restores a tooth that has been weakened by decay, fracture, or prior treatment — returning it to its original shape, strength, and appearance. At Arizona Biltmore Dentistry, crowns are designed to blend naturally with surrounding teeth, providing a durable, long-term solution that protects and preserves your natural tooth structure.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Often recommended after root canal therapy to give the tooth extra strength and protection.</p>
      <p>Listed as a pediatric service.</p>
      <p>Listed as a restorative dentistry service.</p>
      <p>Post-op care instructions are available for crowns.</p>
    </div>
  </section>
</BaseLayout>
