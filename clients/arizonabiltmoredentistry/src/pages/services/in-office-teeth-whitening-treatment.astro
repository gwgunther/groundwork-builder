---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "In-Office Teeth Whitening in Phoenix, AZ",
  "description": "In-office professional whitening session with custom trays and take-home bleach for touch-ups, completed in approximately one hour.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`In-Office Teeth Whitening Treatment Phoenix | ${site.name}`}
  description="In-office professional whitening session with custom trays and take-home bleach for touch-ups, completed in approximately one hour."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      In-Office Teeth Whitening in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      In-office professional whitening session with custom trays and take-home bleach for touch-ups, completed in approximately one hour.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Our natural teeth are meant to be white, bright, and attractive — but over the years, the foods, beverages, and habits of daily life leave their mark. In-office teeth whitening at Arizona Biltmore Dentistry delivers a noticeably brighter result in a single appointment, using professional-strength whitening agents applied and monitored by our clinical team. The outcome is more consistent and more dramatic than anything available over the counter.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Reserve Your Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Comes with custom trays fit to your smile and an extra tube of whitening bleach for touch-ups.</p>
      <p>Can be completed in as little as an hour.</p>
      <p>Results can last for years when used with custom trays at home.</p>
    </div>
  </section>
</BaseLayout>
