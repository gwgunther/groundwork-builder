---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Veneers & Lumineers in Phoenix, AZ",
  "description": "Porcelain veneers and Lumineers to improve the appearance of teeth and create a smile makeover.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Veneers & Lumineers Phoenix | ${site.name}`}
  description="Porcelain veneers and Lumineers to improve the appearance of teeth and create a smile makeover."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Veneers &amp; Lumineers in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Porcelain veneers and Lumineers to improve the appearance of teeth and create a smile makeover.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Porcelain veneers and Lumineers are thin, custom-crafted shells bonded to the front surface of the teeth to correct discoloration, chips, uneven spacing, or shape irregularities. At Arizona Biltmore Dentistry, veneers are designed in close collaboration with the patient — with attention to proportion, shade, and how they relate to the overall smile — so that the result looks intentional, not overdone.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Listed as one of the cosmetic procedures performed at Arizona Biltmore Dentistry.</p>
      <p>Porcelain veneers are referenced as part of the smile makeover team's services.</p>
    </div>
  </section>
</BaseLayout>
