---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Clear Aligners in Phoenix, AZ",
  "description": "Clear aligners are one of the best alternatives to traditional braces. Learn why clear aligners are one of the best options for teeth straightening.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Arizona Biltmore Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Phoenix"
    }
  }
};
---

<BaseLayout
  title={`Clear Aligners Phoenix | ${site.name}`}
  description="Clear aligners are one of the best alternatives to traditional braces. Learn why clear aligners are one of the best options for teeth straightening."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Clear Aligners in Phoenix, AZ
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Clear aligners are one of the best alternatives to traditional braces. Learn why clear aligners are one of the best options for teeth straightening.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Arizona Biltmore Dentistry offers comprehensive clear aligners for adults and teens at our family practice. Clear aligners use a series of custom, transparent trays — rather than brackets and wires — to move teeth gradually into alignment. Each pair is worn for approximately two weeks before progressing to the next set. Treatment is digitally mapped in advance, so you can preview your results before committing. There are no dietary restrictions, and the trays are removable for brushing, flossing, and meals.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Uses a series of aligners instead of brackets and wires to move teeth.</p>
      <p>Each pair of aligners is worn for about two weeks before progressing to the next set.</p>
      <p>Provides proven, predictable, and efficient results for people with mild to severe crowding and gaps.</p>
      <p>Developed over 20 years ago.</p>
      <p>Benefits include freedom to enjoy any food, easier home care and maintenance, gentler and more comfortable design, transparent for ultimate discreteness, removable for flossing and eating, and digitally mapped in advance.</p>
      <p>Patients with minor tooth misalignment may be able to complete clear aligners in just 4-6 months.</p>
      <p>Most traditional bite alignment is completed in about 12-24 months.</p>
      <p>Allows patients to virtually preview results before treatment starts using unique planning software.</p>
      <p>During the exam, the dentist evaluates the bite, oral health status, scans teeth, takes photos, and submits records to determine how many sets of trays are needed.</p>
      <p>Once the case is approved and paid for, aligners are printed and shipped to the practice.</p>
      <p>No need to visit an off-site orthodontist's office.</p>
      <p>Alternatives include traditional braces and ClearCorrect.</p>
      <p>Clear aligner patients do not need to schedule 'adjustment' appointments.</p>
      <p>Enjoy fewer and shorter trips to the office throughout the clear aligner experience.</p>
    </div>
  </section>
</BaseLayout>
