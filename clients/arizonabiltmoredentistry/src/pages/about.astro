---
/**
 * About page — uniform iteration over doctors[].
 *
 * doctors[0] is the featured doctor (full hero treatment with bio).
 * doctors.slice(1) get the team-section card treatment.
 *
 * For single-doctor practices, doctors.length === 1 → only the hero renders,
 * the team section is conditional.
 *
 * Doctor data + portraits flow through:
 *   silver.doctors[]                      ← extraction
 *   → merged.doctors[]                    ← merger
 *   → injector writes doctors[] in site.ts
 *   → image-roles.json doctorPortraits[]  ← Vision-classifier paired by name
 *   → this template iterates doctors[]
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import { site, doctors, address, localBusinessSchema, personSchemas, staff } from '../config/site';
import { readFileSync } from 'node:fs';

// Resolve image-roles for doctor portraits (paired by name in ai-image-roles).
// Names from site.ts may differ slightly from image-roles keys (e.g. "Dr. Russell
// Chang" in site.ts vs "Dr. Russell EK Chang" in image-roles when the injector
// strips middle initials). Match progressively: exact → first+last token →
// last-name only. Stops at the first hit.
let imageRoles: any = { doctorPortraits: {} };
try {
  imageRoles = JSON.parse(readFileSync(`${process.cwd()}/public/images/image-roles.json`, 'utf8'));
} catch { /* manifest missing in dev */ }
const normalize = (s: string) => String(s || '').toLowerCase().replace(/^dr\.?\s+/i, '').replace(/[^a-z\s]/g, '').trim();
const portraitFor = (name: string): string | null => {
  const portraits = imageRoles.doctorPortraits || {};
  // 1. Exact match
  if (portraits[name]) return `/images/${portraits[name]}`;
  // 2. Token-set fuzzy match — every meaningful (3+ char) token in the
  //    look-up name must appear in the candidate key.
  const want = new Set(normalize(name).split(/\s+/).filter(t => t.length >= 3));
  if (want.size === 0) return null;
  for (const [key, path] of Object.entries(portraits)) {
    const have = new Set(normalize(key).split(/\s+/).filter(t => t.length >= 3));
    let ok = true;
    for (const t of want) if (!have.has(t)) { ok = false; break; }
    if (ok) return `/images/${path}`;
  }
  return null;
};

const featured = doctors[0];
const supporting = doctors.slice(1);
---

<BaseLayout
  title={`About ${featured.name} — ${site.name}`}
  description={`Meet ${featured.name}, ${featured.credentials}. Learn about our practice, philosophy, and commitment to exceptional dental care in ${address.city}.`}
  schema={[localBusinessSchema, ...personSchemas]}
>
  <!-- Hero — featured (primary) doctor -->
  <section class="bg-surface-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-highlight mb-4">About Our Practice</p>
          <h1 class="section-heading mb-6">Meet {featured.name}</h1>
          {featured.bio ? (
            <div class="text-lg text-neutral-mid leading-relaxed space-y-4 mb-4">
              {featured.bio.split('\n\n').slice(0, 2).map((p) => <p>{p}</p>)}
            </div>
          ) : (
            <p class="text-lg text-neutral-mid leading-relaxed mb-4">
              {featured.name} provides exceptional dental care to patients in {address.city}.
            </p>
          )}
          {featured.education && (
            <p class="text-neutral-mid leading-relaxed">
              {featured.credentials}{featured.education ? ` — ${featured.education}` : ''}
            </p>
          )}
        </div>
        {(() => {
          const photo = portraitFor(featured.name);
          return photo ? (
            <div class="rounded-2xl overflow-hidden aspect-[4/5]">
              <img src={photo} alt={featured.name} class="w-full h-full object-cover object-top" loading="lazy" />
            </div>
          ) : (
            <div class="bg-neutral-light rounded-2xl aspect-[4/5] flex items-center justify-center">
              <p class="text-neutral-mid text-sm">Doctor Photo</p>
            </div>
          );
        })()}
      </div>
    </div>
  </section>

  <!-- Team section — supporting doctors. Conditional on length > 0. -->
  {supporting.length > 0 && (
    <section class="py-16 md:py-24 bg-surface-1">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 md:mb-16">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-highlight mb-4">Our Team</p>
          <h2 class="section-subheading">Meet Our Doctors</h2>
        </div>
        <div class={`grid gap-12 md:gap-16 ${supporting.length === 1 ? 'md:grid-cols-1 max-w-4xl mx-auto' : supporting.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'}`}>
          {supporting.map((d) => {
            const photo = portraitFor(d.name);
            return (
              <article class="grid grid-cols-1 sm:grid-cols-3 gap-6 items-start">
                <div class="sm:col-span-1">
                  {photo ? (
                    <img src={photo} alt={d.name} class="w-full aspect-[4/5] object-cover object-top rounded-2xl" loading="lazy" />
                  ) : (
                    <div class="w-full aspect-[4/5] rounded-2xl bg-neutral-light flex items-center justify-center text-neutral-mid text-xs">
                      {d.firstName?.charAt(0) || '?'}
                    </div>
                  )}
                </div>
                <div class="sm:col-span-2">
                  <h3 class="font-serif text-2xl md:text-3xl font-bold text-neutral-dark mb-2">{d.name}</h3>
                  {d.credentials && (
                    <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary mb-4">{d.credentials}</p>
                  )}
                  {d.bio && (
                    <p class="text-neutral-mid leading-relaxed">{d.bio}</p>
                  )}
                  {d.education && (
                    <p class="text-sm text-neutral-mid mt-3 italic">{d.education}</p>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Staff — non-doctor team members. Visually distinct from the doctor
       grid above (smaller cards, "Our Team" framing) so doctors stay primary. -->
  {staff && staff.length > 0 && (
    <section class="py-16 md:py-24 bg-surface-2 border-t border-border-light">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-highlight mb-4">Our Team</p>
          <h2 class="section-subheading">Meet the People Who Care for You</h2>
        </div>
        <div class={`grid gap-8 ${staff.length === 1 ? 'md:grid-cols-1 max-w-sm mx-auto' : staff.length === 2 ? 'md:grid-cols-2 max-w-3xl mx-auto' : staff.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2 lg:grid-cols-4'}`}>
          {staff.map((member) => (
            <div class="text-center">
              <div class="aspect-square rounded-2xl bg-neutral-light mb-4 overflow-hidden flex items-center justify-center">
                {member.photoPath ? (
                  <img src={`/images/${member.photoPath}`} alt={member.name} class="w-full h-full object-cover object-top" loading="lazy" />
                ) : (
                  <span class="text-2xl font-serif text-neutral-mid">{member.name?.charAt(0) || '?'}</span>
                )}
              </div>
              <h3 class="font-serif text-lg font-bold text-neutral-dark">{member.name}</h3>
              {member.role && member.role !== 'other' && (
                <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mt-1">
                  {member.role.replace(/_/g, ' ')}
                </p>
              )}
              {member.credentials && (
                <p class="text-xs text-neutral-mid mt-1">{member.credentials}</p>
              )}
              {member.bio && (
                <p class="text-sm text-neutral-mid mt-3 leading-relaxed">{member.bio}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Philosophy -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-subheading text-center mb-8">Our Philosophy</h2>
      <div class="prose-dental">
        <p>
          We believe every patient deserves honest, transparent dental care without pressure. Our goal is to educate you about your options and help you make the best decision for your smile and your budget.
        </p>
        <p>
          Whether you need a simple cleaning or a complex restoration, we treat every patient with the same attention to detail and commitment to excellence.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CTABlock phone={site.phone} />
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Meet the Team</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">Arizona native Dr. Aaron Jeziorski is a passionate dentist dedicated to exceptional patient care. With a Doctor of Dental Medicine from A.T. Still University, Dr. Jeziorski stays at the forefront of dental innovation through continuous education. He mentors dental students at the Central Arizona Shelter Services Clinic and is a dedicated family man with four children. What sets him apart? He gives patients his personal cell phone number—now that's commitment to your care.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">ADVANCED TECHNOLOGY</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">In order to bring you the best care possible, we invest in leading-edge technology to make your appointments as efficient and effective as possible. Arizona Biltmore Dentistry's professionalism, quality, and ability to communicate effectively sets us apart from our competition and the reason we are rated one of the best dentists by The Phoenix Review.</p><p class="mb-4">Digital X-rays deliver images immediately and emit up to 90% less radiation. Cone beam imaging (CBCT) allows us to take detailed 3D images for precise planning.</p><p class="mb-4">See what we see inside your mouth with high-definition pictures and videos. We can walk you through your diagnosis and treatment plan easily.</p><p class="mb-4">Using DIAGNOdent® technology, we can find even small amounts of decay and remove them before they cause major problems. This allows for smaller fillings to be placed.</p><p class="mb-4">LANAP® laser technology lets us treat gum disease without the need for scalpels or sutures, making for an easier and faster recovery.</p><p class="mb-4">The Isolite® Comfort System has a soft bite block where you can rest your jaw. Its hydration and suction system also eliminates the need for rinse breaks.</p><p class="mb-4">Rather than dealing with messy traditional impressions, we can use our 3shape digital scanner to take more accurate, more comfortable impressions.</p><p class="mb-4">We provide computer-guided implant surgery using 3D cone beam scanning for safe, predictable, and efficient results.</p><p class="mb-4">The SonicFill™ technique allows us to accurately seal cavities with a tooth-colored, mercury-free material, all in one quick step.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Visit Our Phoenix Dental Office</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">Looking for a Phoenix dental office that has it all – a knowledgeable and friendly team, a warm environment, advanced technology, and convenient hours? At Arizona Biltmore Dentistry, we have all of that! We see patients of all ages, so no matter your needs or your family's needs, we can help ensure everyone has a healthy, beautiful smile.</p><p class="mb-4">While your smile is our number one priority, your comfort is important to us, too. We've designed an office that encourages you to relax and make yourself at home from the moment you walk through the door to the moment you leave. While you're with us, enjoy the following amenities: Office-Wide WiFi, Comfortable Pillows &amp; Blankets, Magazines.</p><p class="mb-4">Fitting in dental appointments around work, school, and activity schedules can be difficult, but that doesn't mean you should let your oral health slide. We aim to make visits to our Phoenix dental office as easy and stress-free as possible by providing convenient scheduling options.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Why Choose Us for Your Pediatric Dentistry?</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">At Arizona Biltmore Dentistry, we do more than just treat the dental needs of every member of the family. We work to build good oral health habits and help local parents, teens and children alike develop a lifelong enthusiasm for dental hygiene. When children have positive dental experiences early in life, they are more likely to continue good oral health habits and have a lifetime of healthy smiles.</p><p class="mb-4">The pediatric dental team at Arizona Biltmore Dentistry are highly trained and experienced in working with patients of all ages. Their training includes the unique needs of infants, children and adolescents — including children with special needs.</p><p class="mb-4">At Arizona Biltmore Dentistry, we go above and beyond to offer children a fun and smile-friendly environment they can feel comfortable in. Our team is energetic, outgoing — even downright funny at times. We work hard to alleviate dental anxieties so your child's visit is a positive one.</p><p class="mb-4">Worried about bringing in little kids or waiting with other children? Our toybox is famous across the valley and has actual toys -- none of those cheap knick knacks that are always broken. We've got barbies, hotwheels, coloring books, dolls, balls, and more. It will be easy for your kids to forget that they are even at the dentist office.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Dental Implants Phoenix, AZ</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">At Arizona Biltmore Dentistry, we sometimes see new patients who are missing one or more of their natural teeth because of tooth decay, periodontal disease, or an injury. Up until a few years ago, the only treatment options available for patients with missing teeth were dentures and dental bridges. But thanks to new innovations in the field of restorative and implant dentistry, those same patients can now come to our Phoenix office and get dental implants so that their smiles look, feel, and perform just like new.</p><p class="mb-4">If missing teeth make you feel like you're missing out on certain things like smiling with confidence, talking with ease, and eating your favorite foods, we can help! At Arizona Biltmore Dentistry, we provide start-to-finish dental implant care to help you with missing teeth replacement and get a full, and fully functioning, smile once again. Dental implants are preferred by dentists and patients alike for replacing missing teeth, so come in for a privacy-protected consultation to learn how they can benefit your smile.</p><p class="mb-4">Utilizing state-of-the-art computer-aided dental implant technologies, we eliminate uncertainties, providing a pathway to optimal safety and aesthetic results for our patients.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">All-on-4 in Phoenix</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">Are you looking for a comfortable, secure, and attractive way to replace all of your missing teeth? Arizona Biltmore Dentistry provides innovative full mouth dental implant therapy known as &quot;All-on-4&quot; in Phoenix.</p><p class="mb-4">All-on-4 treatment utilizes the integrity of four strategically-placed dental implants to support a hybrid, full-arch restoration. This streamlined device merges the efficiency of dentures with the comfort and functionality of dental implants. Only in this case, there are no bulky &quot;plates&quot; across the roof of your mouth or devices to take out at night; everything is naturally designed and permanently affixed into place.</p><p class="mb-4">Today's dental implants have the highest success rate of any restorative treatment in modern dentistry. By facilitating start-to-finish implant therapy under one roof, we're able to provide both more efficient and affordable implant treatment.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Root Canal Therapy</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">A tooth infection, deep decay, or even dental trauma can cause a problem deep within the tooth that leaves you in pain. In an effort to save your natural tooth and relieve your pain, our team can perform root canal therapy to remove the damaged tissue. We know that the thought of a root canal can make patients feel nervous, but rest assured that our advanced treatment is gentle and we offer sedation options to help you stay comfortable throughout the procedure.</p><p class="mb-4">Despite common thinking, a root canal procedure isn't something to be scared of. The procedure is gentle and can relieve your tooth pain quickly -- And you don't always need to see an expensive specialist or endodontist for most cases!</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Clear Aligners in Phoenix AZ</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">Are you looking for an experienced clear aligner dentist in Phoenix? Arizona Biltmore Dentistry is proud to offer comprehensive clear aligners for adults and teens at our family practice. Here you can enjoy personalized care that fits your busy schedule—with a team you already know and trust!</p><p class="mb-4">Clear Aligners are an &quot;invisible&quot; type of braces that uses a series of aligners—instead of brackets and wires—to move your teeth. You wear each pair for about two weeks before progressing to the next set. Pair by pair, your aligners gently nudge your teeth into alignment.</p><p class="mb-4">Developed over 20 years ago, Clear Aligners provide proven, predictable, and efficient results for people with mild to severe crowding and gaps. Our patients with minor tooth misalignment may be able to complete clear aligners in just 4-6 months. However, most traditional bite alignment is completed in about 12-24 months.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Top Cosmetic Dentist in Phoenix</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">If you're like most people in the Phoenix, AZ, area, there's something you'd like to improve about your smile. Smile imperfections take many forms, and can negatively affect your self-esteem, relationships and success. At Arizona Biltmore Dentistry, our licensed dentists are highly trained to provide several types of affordable in-office cosmetic dentistry procedures designed to make your dream smile come true. From porcelain veneers, to orthodontics and teeth whitening, our smile makeover team has the reliable cosmetic services you deserve!</p><p class="mb-4">At Arizona Biltmore Dentistry, our licensed dentists can perform these safe and affordable cosmetic procedures in the relaxed and comfortable surroundings of our Phoenix office: Dental Bonding, Dental Implants, Dentures, Orthodontics using ClearCorrect &amp; clear aligners, Smile Makeovers, Teeth Whitening, Veneers &amp; Lumineers.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Set Sail to Paradise with Arizona Biltmore Dentistry!</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">Your passage to relaxation awaits! Arizona Biltmore Dentistry is thrilled to give our wonderful patients the chance to win an all-expenses-paid 3-night Carnival Cruise to Ensenada, Mexico for two. It's our way of saying thank you for trusting us with your smiles—and now we want to send you somewhere you can show yours off in style.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">Restorative Dentistry in Phoenix, AZ</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">If you're suffering from broken, severely discolored, missing, or infected teeth, restorative dentistry can get you back to the smile you know and love. From crowns to root canals to start-to-finish dental implants, when you choose Arizona Biltmore Dentistry, you're putting your smile in good hands.</p><p class="mb-4">We don't want you to miss out on the finer side of life over self-confidence issues because of your smile. Get back to that smile you know and love.</p><p class="mb-4">Our restorative treatments include: Tooth-Colored Fillings, Dental Crowns, Bridges, Full &amp; Partial Dentures, Start-to-Finish Dental Implants, Root Canal Therapy, Tooth Extractions, and Bone Grafts.</p></div>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading mb-4">A Comfortable and Affordable Dental Care Experience by a Phoenix Dentist</h2>
      <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed"><p class="mb-4">Through our years of practice and feedback from hundreds of patients — we've created a dental experience that is different from any other.</p><p class="mb-4">We know that many people in Phoenix, AZ don't like visiting the dentist. In fact, dental anxiety is very common. That's why we go above and beyond to make our patients feel good and relaxed the moment they walk into our office to the time they leave. They know immediately that they will be treated to a one-of-a-kind dental experience that includes: comforting amenities (office-wide WIFI, freshly-scented pillows &amp; blankets, and magazines), relaxing exam rooms, cutting-edge equipment (3D computer renderings, intraoral cameras, laser cameras, and digital X-rays that feature the safest lowest-level radiation exposure with the highest image resolution), and kind, highly-trained staff who attend continuing education courses to stay up to date on the latest techniques and technologies in the industry.</p></div>
    </div>
  </section>
</BaseLayout>
