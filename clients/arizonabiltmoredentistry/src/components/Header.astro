---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'


---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-100">
  <nav
    class="max-w-7xl mx-auto px-6 flex items-center justify-between h-16"
    aria-label="Main navigation"
    x-data="{ mobileOpen: false }"
  >

    <!-- Logo / Practice Name -->
    <a
      href="/"
      class="flex-shrink-0 font-serif text-xl font-bold tracking-tight text-neutral-dark hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      aria-label="Arizona Biltmore Dentistry — home"
    >
      Arizona Biltmore Dentistry
    </a>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex items-center gap-8">

      <!-- Meet Jeziorski -->
      <a
        href="/about"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      >
        Meet Dr. Jeziorski
      </a>

      <!-- Services Dropdown -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg
            class="w-3.5 h-3.5 mt-px transition-transform duration-200 group-hover:rotate-180"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Dropdown panel — pt-2 bridges hover gap, never mt-2 -->
        <div class="absolute top-full left-0 pt-2 w-64 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150">
          <div class="bg-white shadow-lg rounded-xl border border-neutral-100 py-2 overflow-hidden">
            <a
              href="/services/3shape-digital-scanner"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
            >
              3shape Digital Scanner
            </a>
            <a
              href="/services/all-on-4"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
            >
              All-on-4
            </a>
            <a
              href="/services/bone-grafts"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
            >
              Bone Grafts
            </a>
            <a
              href="/services/bridges"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
            >
              Bridges
            </a>
            <a
              href="/services/brushing-flossing-instruction"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
            >
              Brushing &amp; Flossing Instruction
            </a>
            <a
              href="/services/candidpro"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
            >
              CandidPro
            </a>
            <div class="mx-4 my-1 border-t border-neutral-100"></div>
            <a
              href="/services"
              class="block px-4 py-2.5 text-sm font-semibold text-brand-primary hover:bg-neutral-50 transition-all duration-200 whitespace-nowrap"
            >
              All Services →
            </a>
          </div>
        </div>
      </div>

      <!-- Blog -->
      <a
        href="/blog"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      >
        Blog
      </a>

      <!-- FAQ -->
      <a
        href="/faq"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      >
        FAQ
      </a>

    </div>

    <!-- Desktop Right: Phone + CTA -->
    <div class="hidden lg:flex items-center gap-4">
      <a
        href="tel:+16029578200"
        class="tabular-nums text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap min-h-11 flex items-center"
        aria-label="Call Arizona Biltmore Dentistry at (602) 957-8200"
      >
        (602) 957-8200
      </a>

      <a
        href="/schedule"
        class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-center hover:opacity-90 whitespace-nowrap ml-6"
      >
        Book Appointment
      </a>
    </div>

    <!-- Mobile: Phone + Hamburger -->
    <div class="flex lg:hidden items-center gap-3">
      <a
        href="tel:+16029578200"
        class="tabular-nums text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 min-h-11 min-w-11 flex items-center justify-center"
        aria-label="Call (602) 957-8200"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C9.61 21 3 14.39 3 6a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <button
        type="button"
        class="min-h-11 min-w-11 flex items-center justify-center text-neutral-700 hover:text-brand-primary transition-all duration-200"
        @click="mobileOpen = !mobileOpen"
        :aria-expanded="mobileOpen.toString()"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg
          class="w-6 h-6"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          x-show="!mobileOpen"
        >
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg
          class="w-6 h-6"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          x-show="mobileOpen"
          x-cloak
        >
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    x-cloak
    class="lg:hidden border-t border-neutral-100 bg-white"
    x-data="{ servicesOpen: false }"
  >
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-1">

      <a
        href="/about"
        class="block py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border-b border-neutral-50"
        @click="mobileOpen = false"
      >
        Meet Dr. Jeziorski
      </a>

      <!-- Mobile Services Accordion -->
      <div class="border-b border-neutral-50">
        <button
          type="button"
          class="w-full flex items-center justify-between py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200"
          @click="servicesOpen = !servicesOpen"
          :aria-expanded="servicesOpen.toString()"
        >
          Services
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200"
            :class="servicesOpen ? 'rotate-180' : ''"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div
          x-show="servicesOpen"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          class="pb-2 pl-4 flex flex-col gap-1"
        >
          <a href="/services/3shape-digital-scanner" class="block py-2 text-sm text-neutral-600 hover:text-brand-primary transition-all duration-200" @click="mobileOpen = false">3shape Digital Scanner</a>
          <a href="/services/all-on-4" class="block py-2 text-sm text-neutral-600 hover:text-brand-primary transition-all duration-200" @click="mobileOpen = false">All-on-4</a>
          <a href="/services/bone-grafts" class="block py-2 text-sm text-neutral-600 hover:text-brand-primary transition-all duration-200" @click="mobileOpen = false">Bone Grafts</a>
          <a href="/services/bridges" class="block py-2 text-sm text-neutral-600 hover:text-brand-primary transition-all duration-200" @click="mobileOpen = false">Bridges</a>
          <a href="/services/brushing-flossing-instruction" class="block py-2 text-sm text-neutral-600 hover:text-brand-primary transition-all duration-200" @click="mobileOpen = false">Brushing &amp; Flossing Instruction</a>
          <a href="/services/candidpro" class="block py-2 text-sm text-neutral-600 hover:text-brand-primary transition-all duration-200" @click="mobileOpen = false">CandidPro</a>
          <a href="/services" class="block py-2 text-sm font-semibold text-brand-primary hover:underline transition-all duration-200" @click="mobileOpen = false">All Services →</a>
        </div>
      </div>

      <a
        href="/blog"
        class="block py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border-b border-neutral-50"
        @click="mobileOpen = false"
      >
        Blog
      </a>

      <a
        href="/faq"
        class="block py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border-b border-neutral-50"
        @click="mobileOpen = false"
      >
        FAQ
      </a>

      <div class="pt-4 pb-2 flex flex-col gap-3">
        <a
          href="tel:+16029578200"
          class="tabular-nums text-center py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border border-neutral-200 rounded-lg min-h-11 flex items-center justify-center"
          aria-label="Call Arizona Biltmore Dentistry"
        >
          (602) 957-8200
        </a>
        <a
          href="/schedule"
          class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-center hover:opacity-90 min-h-11"
          @click="mobileOpen = false"
        >
          Book Appointment
        </a>
      </div>

    </div>
  </div>
</header>