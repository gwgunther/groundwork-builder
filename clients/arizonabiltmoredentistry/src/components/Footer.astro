---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'



const currentYear = new Date().getFullYear()

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Blog', href: '/blog' },
  { label: 'Schedule', href: '/schedule' },
]

const socialLinks = [
  {
    label: 'Google Reviews',
    href: 'https://maps.google.com/?cid=10483446600579265121',
    icon: 'google',
  },
  {
    label: 'Yelp',
    href: 'https://www.yelp.com/biz/arizona-biltmore-dentistry-phoenix',
    icon: 'yelp',
  },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/arizonabiltmoredentistry?fref=ts',
    icon: 'facebook',
  },
]
---

<footer class="w-full bg-neutral-dark text-white" role="contentinfo">

  <!-- Top rule -->
  <div class="w-full border-t border-white/10"></div>

  <!-- Main editorial-split grid -->
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-24 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-24">

    <!-- Left column: large practice name + address + phone + social -->
    <div class="flex flex-col gap-8">

      <!-- Practice name at editorial scale -->
      <div>
        <span class="text-sm font-semibold uppercase tracking-widest text-white/70 block mb-3">
          Phoenix, Arizona
        </span>
        <p class="font-serif text-3xl md:text-5xl font-bold leading-tight tracking-tight text-white">
          {site.name}
        </p>
      </div>

      <!-- Address block -->
      <address class="not-italic flex flex-col gap-1 text-base leading-relaxed text-white/70">
        <span>{addr.street}</span>
        {addr.suite && <span>{addr.suite}</span>}
        <span>{addr.city}, {addr.state} {addr.zip}</span>
        <a
          href={`tel:${site.phone.replace(/\D/g, '')}`}
          class="mt-2 text-white font-semibold text-lg underline underline-offset-2 hover:text-white/80 transition-all duration-200 inline-block min-h-[44px] flex items-center gap-2"
          aria-label={`Call us at ${site.phone}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.08 6.08l1.01-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          {site.phone}
        </a>
      </address>

      <!-- Social / review links -->
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold uppercase tracking-widest text-white/60">Find Us Online</p>
        <ul class="flex flex-col gap-2" role="list">
          {socialLinks.map(link => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-base leading-relaxed text-white/70 hover:text-brand-primary transition-all duration-200 min-h-[44px]"
                aria-label={`Visit our ${link.label} page (opens in new tab)`}
              >
                {link.icon === 'google' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                  </svg>
                )}
                {link.icon === 'yelp' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm-1.086 13.5c-.05.27-.27.45-.54.45H7.5c-.3 0-.54-.21-.57-.51-.03-.27.12-.54.39-.63l2.85-.96V9.75c0-.3.24-.54.54-.54s.54.24.54.54v4.5l-.33.75zm4.086-1.5c-.12.24-.39.36-.63.27l-2.85-.96v-4.5c0-.3.24-.54.54-.54s.54.24.54.54v3.6l2.52.84c.27.09.42.39.3.66l-.42.09z"/>
                  </svg>
                )}
                {link.icon === 'facebook' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                )}
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Right column: nav links + hours if available -->
    <div class="flex flex-col gap-10 md:pt-2">

      <!-- Navigation -->
      <nav aria-label="Footer navigation">
        <p class="text-sm font-semibold uppercase tracking-widest text-white/60 mb-4">Navigation</p>
        <ul class="flex flex-col gap-1" role="list">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="inline-block text-base leading-relaxed text-white/70 hover:text-brand-primary transition-all duration-200 py-1 min-h-[44px] flex items-center"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Hours block — only if site.hours is defined -->
      {site.hours && (
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-white/60 mb-4">Office Hours</p>
          <ul class="flex flex-col gap-2" role="list">
            {Object.entries(site.hours).map(([day, hours]) => (
              <li class="flex justify-between gap-4 text-base leading-relaxed text-white/70">
                <span class="font-medium text-white/90">{day}</span>
                <span>{hours}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Schedule CTA -->
      <div class="mt-auto pt-4">
        <a
          href="/schedule"
          class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-center hover:opacity-90"
        >
          Book Appointment
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom rule + copyright -->
  <div class="w-full border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-6 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-sm leading-relaxed text-white/60 text-center sm:text-left">
        &copy; {currentYear} {site.name}. All rights reserved.
      </p>
      <p class="text-sm leading-relaxed text-white/60 text-center sm:text-right">
        {addr.city}, {addr.state}
      </p>
    </div>
  </div>

</footer>