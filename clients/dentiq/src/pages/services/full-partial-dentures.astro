---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Full & Partial Dentures",
  "description": "Custom-fitted dentures for a natural look and comfortable fit. Affordable tooth replacement in Houston, TX.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Full & Partial Dentures Houston | ${site.name}`}
  description="Custom-fitted dentures for a natural look and comfortable fit. Affordable tooth replacement in Houston, TX."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Full &amp; Partial Dentures
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Custom-fitted dentures for a natural look and comfortable fit. Affordable tooth replacement in Houston, TX.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Missing teeth shouldn't make you hide your smile. Dentures and partials are made to restore the look and function of your teeth with a fit that's customized to you. Both a full denture and a partial will help to transform your smile. If you're missing your natural teeth, there is no reason to feel ashamed — we can make a personalized plan that fits your goals and budget.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Conventional Denture (non-implant-supported) priced at $1,995</p>
    </div>
  </section>
</BaseLayout>
