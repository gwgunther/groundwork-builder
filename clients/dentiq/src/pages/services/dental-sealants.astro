---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Dental Sealants",
  "description": "A simple coating to protect back teeth from decay. Ideal for children and adults prone to cavities.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Dental Sealants Houston | ${site.name}`}
  description="A simple coating to protect back teeth from decay. Ideal for children and adults prone to cavities."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Dental Sealants
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      A simple coating to protect back teeth from decay. Ideal for children and adults prone to cavities.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Dental sealants are thin, clear coatings we place on the chewing surfaces of your back teeth to help block out cavity-causing bacteria and the deep stains that like to settle into those grooves. Sealants can help protect your back teeth, where tiny grooves and pits tend to trap food and plaque even with good brushing. By sealing those hard-to-reach areas, it's easier to keep the teeth clean and reduce the risk of decay over time.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

</BaseLayout>
