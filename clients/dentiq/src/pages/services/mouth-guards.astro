---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Custom Mouth Guards",
  "description": "Protect your smile from grinding (bruxism) or sports injuries with a custom-fitted mouth guard.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Mouth Guards Houston | ${site.name}`}
  description="Protect your smile from grinding (bruxism) or sports injuries with a custom-fitted mouth guard."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Custom Mouth Guards
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Protect your smile from grinding (bruxism) or sports injuries with a custom-fitted mouth guard.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Whether you're an athlete on the field or someone who deals with stress by clenching your teeth at night, your smile is constantly under pressure. A mouthguard acts as a vital buffer between your teeth, absorbing impact and reducing wear. Custom-fitted guards from Dentiq provide superior protection and comfort compared to store-bought options — designed specifically for your bite.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Two types available: Occlusal Mouthguard (for nighttime grinding/bruxism) and Sports Mouthguard</p>
      <p>Occlusal mouthguard uses durable, medical-grade acrylic to withstand even the heaviest pressure</p>
      <p>Each guard is custom-made for the patient's smile</p>
      <p>Sports mouthguards use a specialized softer material designed to absorb the shock of a sudden blow or impact</p>
      <p>Sports mouthguards shield both teeth and gums for total protection</p>
      <p>Custom-fitted guards are more effective than generic store-bought guards</p>
      <p>Precise molds of teeth are taken to create a durable guard that stays in place</p>
    </div>
  </section>
</BaseLayout>
