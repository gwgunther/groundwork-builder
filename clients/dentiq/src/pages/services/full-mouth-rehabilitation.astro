---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Life Changing Full Mouth Reconstruction",
  "description": "Combine veneers, whitening, and implants for a totally new look. Plan your dream smile with Dr. Sista.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Full Mouth Rehabilitation Houston | ${site.name}`}
  description="Combine veneers, whitening, and implants for a totally new look. Plan your dream smile with Dr. Sista."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Life Changing Full Mouth Reconstruction
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Combine veneers, whitening, and implants for a totally new look. Plan your dream smile with Dr. Sista.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">A full mouth reconstruction, often called a smile makeover, is a personalized way to rebuild your smile when it no longer looks or feels like you. Dr. Sista and Dr. Tag provide everything from preventive care to full-mouth rehabilitation — combining restorative and cosmetic procedures into a single coordinated treatment plan built around your needs.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Duration varies depending on the complexity of the case and the specific treatments involved</p>
      <p>Can range from several weeks to several months</p>
      <p>Requires thorough planning, coordination, and implementation of various procedures to achieve optimal results</p>
    </div>
  </section>
</BaseLayout>
