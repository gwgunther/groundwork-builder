---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Professional Whitening That Looks Natural",
  "description": "Get a brighter, whiter smile in one visit. Professional-grade whitening is safer and more effective than DIY kits.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Teeth Whitening Houston | ${site.name}`}
  description="Get a brighter, whiter smile in one visit. Professional-grade whitening is safer and more effective than DIY kits."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Professional Whitening That Looks Natural
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Get a brighter, whiter smile in one visit. Professional-grade whitening is safer and more effective than DIY kits.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Teeth whitening is a simple way to get a brighter smile and feel more confident. At Dentiq, we'll help you choose the right whitening option and set clear expectations upfront. Coffee, tea, red wine, tobacco, and certain medications can dull teeth over time, even with good brushing. Professional whitening lifts those stains safely and delivers results that over-the-counter kits typically can't match.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Whitening Visit</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Professional teeth whitening is both safe and highly effective</p>
      <p>Can remove stubborn stains and brighten your smile, resulting in a noticeable improvement in tooth color</p>
      <p>In-office whitening procedures typically use a powerful bleaching agent combined with a special light to accelerate the process, resulting in noticeably whiter teeth in just one session</p>
      <p>Zoom Whitening priced at $425 - $650</p>
    </div>
  </section>
</BaseLayout>
