---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Digital X-Rays",
  "description": "Dentiq Dentistry offers Digital X-Rays in Houston, TX — safer, faster, and clearer than traditional x-rays.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Digital X-Rays Houston | ${site.name}`}
  description="Dentiq Dentistry offers Digital X-Rays in Houston, TX — safer, faster, and clearer than traditional x-rays."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Digital X-Rays
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Dentiq Dentistry offers Digital X-Rays in Houston, TX — safer, faster, and clearer than traditional x-rays.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Digital x-rays are much safer compared to traditional x-rays — they reduce radiation exposure by up to 90 percent. A sensor or scanner is inserted into the mouth to take images of your teeth and jaw, and the results appear on screen instantly. Digital x-rays help us see decay, infection, bone changes, and teeth that haven't yet erupted — giving our team the ability to treat you promptly and avoid complications.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Visit</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Digital x-rays reduce a patient's radiation exposure by 90 percent</p>
      <p>No concern with radiation exposure, and the new technology has very low levels of radiation</p>
      <p>Images can be conveniently viewed in exam rooms during appointments</p>
      <p>Types include Bite Wing X-Rays, Periapical X-Rays, and Panoramic X-Rays</p>
    </div>
  </section>
</BaseLayout>
