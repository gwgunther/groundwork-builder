---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Digital Dental X-Rays",
  "description": "State-of-the-art digital imaging for precise diagnosis. Safer, faster, and clearer than traditional x-rays.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Dental X-Rays Houston | ${site.name}`}
  description="State-of-the-art digital imaging for precise diagnosis. Safer, faster, and clearer than traditional x-rays."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Digital Dental X-Rays
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      State-of-the-art digital imaging for precise diagnosis. Safer, faster, and clearer than traditional x-rays.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">A dental X-ray is a quick image that helps us see what the eye can't — like what's happening under your teeth and gums. It can reveal early decay, infection, impacted teeth, and bone loss before they turn into bigger problems. The radiation level is very low, and we use the safest approach possible for patients of all ages.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Visit</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Digital x-rays reduce a patient's radiation exposure by 90 percent compared to traditional x-rays</p>
      <p>Images are sent instantly to computer software and can be viewed immediately in the exam room</p>
      <p>Types include Bite Wing X-Rays, Periapical X-Rays, and Panoramic X-Rays</p>
      <p>Bite wing x-rays can detect decay between teeth and evaluate jaw bone condition and existing restorations</p>
      <p>Periapical x-rays take an image of the entire tooth from top to bottom including the root structure and can detect infection or abscess and bone loss in the jaw</p>
      <p>Panoramic x-rays are taken using a machine that rotates around the head, providing an image of the entire mouth, used to monitor wisdom teeth or plan for procedures such as implants</p>
    </div>
  </section>
</BaseLayout>
