---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Porcelain Veneers in Houston TX",
  "description": "Dentiq Dentistry specializes in Cosmetic & Restorative Dentistry and offers Porcelain Veneers in Houston, TX.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Porcelain Veneers Houston | ${site.name}`}
  description="Dentiq Dentistry specializes in Cosmetic & Restorative Dentistry and offers Porcelain Veneers in Houston, TX."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Porcelain Veneers in Houston TX
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Dentiq Dentistry specializes in Cosmetic &amp; Restorative Dentistry and offers Porcelain Veneers in Houston, TX.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Porcelain veneers are thin restorations bonded to the front of your teeth to cover flaws and minor imperfections. They help correct teeth that are cracked, stained, discolored, unevenly spaced, or unsightly — without extensive procedures. Veneers are made specifically for each patient, so they feel and look completely natural. You can expect them to last about a decade before replacement is necessary. At Dentiq, cosmetic dentistry shouldn't feel like a gamble — we use a clear plan and walk you through every step.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Porcelain veneers are thin, durable ceramic covers placed on the front of your teeth to improve how your smile looks</p>
      <p>A common cosmetic dentistry option for fixing issues like stains, chips, gaps, and uneven shape</p>
      <p>If you have good dental health and enough tooth enamel, you may be a suitable candidate</p>
      <p>Getting porcelain veneers usually takes about three visits</p>
      <p>Process starts with a consultation, then preparing the teeth and creating a temporary trial smile, and finally fitting and placing custom veneers</p>
      <p>Veneers can correct chips, cracks, misalignment, gaps between teeth, deep stains and discoloration, uneven or irregularly shaped teeth, and short or worn teeth</p>
      <p>Veneers are a great option for teeth that are discolored or stained and have not improved with whitening treatments</p>
      <p>Can effectively hide imperfections from genetic dark enamel or tetracycline staining</p>
      <p>Upper Veneers package: 6 teeth $6,499 / 8 teeth $8,599 / 10 teeth $10,699</p>
      <p>Upper &amp; Lower Veneers package: 12 teeth $12,589 / 16 teeth $16,789 / 20 teeth $19,989</p>
      <p>Package cost includes smile design/wax up impressions, oral sedation and/or laughing gas, delivery of all restorations, and custom clear retainer</p>
      <p>Additional 7% discount when paid in full</p>
      <p>Zoom Whitening listed at $425 - $650</p>
      <p>Invisalign listed at $4,500 - $5,850</p>
    </div>
  </section>
</BaseLayout>
