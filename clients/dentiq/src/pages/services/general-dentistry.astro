---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Trusted General Dentistry in Houston",
  "description": "Comprehensive general dentistry in Houston, TX, with expert care to keep your smile healthy.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`General Dentistry Houston | ${site.name}`}
  description="Comprehensive general dentistry in Houston, TX, with expert care to keep your smile healthy."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Trusted General Dentistry in Houston
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Comprehensive general dentistry in Houston, TX, with expert care to keep your smile healthy.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Bring the whole family in for a calm, comprehensive look at your oral health. We'll explain what we see in plain English, answer your questions, and map out a clear plan you can feel good about. You'll also leave with simple habits that keep your mouth healthier long after your visit. Dr. Sista and Dr. Tag provide everything from preventive cleanings and exams to fillings, sealants, fluoride treatments, and more.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Book an Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Services include dental x-rays, dental cleanings, dental fillings, fluoride cleanings, dental bonding, nitrous oxide, IV sedation, mouth guards, tooth extractions, and sealants</p>
    </div>
  </section>
</BaseLayout>
