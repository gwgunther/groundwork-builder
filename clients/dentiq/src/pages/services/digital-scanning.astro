---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Digital Scanning",
  "description": "Dentiq Dentistry offers Digital Scanning in Houston, TX — fast, accurate, and comfortable.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Digital Scanning Houston | ${site.name}`}
  description="Dentiq Dentistry offers Digital Scanning in Houston, TX — fast, accurate, and comfortable."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Digital Scanning
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Dentiq Dentistry offers Digital Scanning in Houston, TX — fast, accurate, and comfortable.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Digital scanning uses both a wand and a computer to take impressions of your teeth and mouth. The wand is inserted into the mouth and gently moved around to capture the top and bottom teeth. While the wand moves, the computer captures digital images instantly and displays them on screen. The process is painless and quick — no goopy impression material. Items such as crowns, bridges, retainers, or dentures can be made accurately and quickly from the digital scan.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Used during smile design appointment to take digital scans, bite scans, measurements, and digital impressions</p>
      <p>Creates a photo-realistic 3D digitalization of face and jaw area</p>
      <p>The iTero scanner produces a 3D impression quickly</p>
      <p>Modern Invisalign consultations often involve digital scanning technology</p>
    </div>
  </section>
</BaseLayout>
