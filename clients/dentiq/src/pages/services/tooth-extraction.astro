---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Tooth Extractions",
  "description": "Damaged or painful tooth? We perform gentle extractions when necessary. Discuss replacement options immediately.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Tooth Extraction Houston | ${site.name}`}
  description="Damaged or painful tooth? We perform gentle extractions when necessary. Discuss replacement options immediately."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Tooth Extractions
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Damaged or painful tooth? We perform gentle extractions when necessary. Discuss replacement options immediately.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Extractions help protect your oral health when a tooth is causing pain, infection risk, or ongoing issues that won't improve on their own. Some patients need a tooth removed after advanced gum disease, severe decay, or trauma. Sometimes an extraction is the safest move when a tooth can't be saved — a problem tooth can put the rest of your mouth at risk, so removing it early can prevent shifting, infection, and damage to nearby teeth. We'll walk you through replacement options at the same visit.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>When saving a tooth isn't possible, gentle extractions are performed to relieve pain and protect oral health</p>
      <p>Emergency extractions are available for same-day appointments</p>
    </div>
  </section>
</BaseLayout>
