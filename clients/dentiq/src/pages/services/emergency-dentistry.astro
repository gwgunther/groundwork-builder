---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Same-Day Care for Dental Emergencies",
  "description": "In severe pain? Don't wait. Dentiq offers same-day emergency care in Houston. Broken teeth, extractions & infections. Call now.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Emergency Dentistry Houston | ${site.name}`}
  description="In severe pain? Don't wait. Dentiq offers same-day emergency care in Houston. Broken teeth, extractions & infections. Call now."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Same-Day Care for Dental Emergencies
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      In severe pain? Don't wait. Dentiq offers same-day emergency care in Houston. Broken teeth, extractions &amp; infections. Call now.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Dental emergencies are stressful, and waiting can make things worse. At Dentiq Dentistry, patients get prompt, calm care that focuses on relief first and a clear plan second. Call right away if you have severe tooth pain, swelling, a knocked-out tooth, a broken restoration, or uncontrolled bleeding. Same-day appointments are available.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Call Now — (713) 526-2904</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Same-day and next-day appointments available</p>
      <p>Immediate care provided for severe toothache, broken or knocked-out tooth, jaw injury, and significant swelling</p>
      <p>Services include immediate pain relief, emergency tooth repair, dental infection treatment, and emergency extractions</p>
      <p>If a tooth is knocked out, gently rinse the tooth, place it back in the socket, or store it in milk or saliva until you can see a dentist</p>
      <p>Untreated dental emergencies can lead to systemic infections and complications affecting overall health</p>
    </div>
  </section>
</BaseLayout>
