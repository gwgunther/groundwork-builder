---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Inlays and Onlays",
  "description": "A stronger alternative to large fillings. Preserve your natural tooth structure with custom porcelain inlays.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Dentiq Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houston"
    }
  }
};
---

<BaseLayout
  title={`Inlays and Onlays Houston | ${site.name}`}
  description="A stronger alternative to large fillings. Preserve your natural tooth structure with custom porcelain inlays."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Inlays and Onlays
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      A stronger alternative to large fillings. Preserve your natural tooth structure with custom porcelain inlays.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Inlays and onlays are custom restorations that repair a tooth that is cracked, worn, or weakened — without covering more tooth than necessary. They can also replace old fillings that are failing or no longer look natural. Made from durable porcelain, they blend in with your smile while helping your tooth feel strong again.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>An inlay fits within the grooves of the tooth, while an onlay covers the top biting surface for added strength</p>
      <p>Inlays and onlays can replace old fillings that are failing or no longer look natural</p>
      <p>Made from durable porcelain, they blend in with your smile</p>
      <p>With good care, an inlay or onlay can last for many years</p>
      <p>Recommended when a tooth's damage is too extensive for a filling but not severe enough to warrant a crown</p>
      <p>The procedure involves gently cleaning out the damaged area, shaping the tooth, taking a digital scan or impression, then placing and polishing at a follow-up visit</p>
      <p>They offer a conservative approach, preserving more of the natural tooth structure while providing strength and durability</p>
    </div>
  </section>
</BaseLayout>
