  { name: 'Porcelain Veneers', slug: 'porcelain-veneers', href: '/services/porcelain-veneers', desc: 'Dentiq Dentistry specializes in Cosmetic & Restorative Dentistry and offers Porcelain Veneers in Houston, TX.' },
  { name: 'Ridge Augmentation', slug: 'ridge-augmentation', href: '/services/ridge-augmentation', desc: 'Restore the natural contour of your gums and jaw. Essential preparation for successful dental implants.' },
  { name: 'Root Canal', slug: 'root-canal', href: '/services/root-canal', desc: 'Stop the toothache and save your tooth. Dr. Sista performs gentle root canal therapy to eliminate infection.' },
  { name: 'Sedation Dentistry', slug: 'sedation-dentistry', href: '/services/sedation-dentistry', desc: 'Lose your fear of treatment with stress-free sedation dentistry in Houston, TX.' },
  { name: 'Single Tooth Implants', slug: 'single-tooth-implants', href: '/services/single-tooth-implants', desc: 'Replace a missing tooth permanently. Includes implant, abutment, and crown. Match your natural smile with Dr. Sista.' },
  { name: 'Smile Makeovers', slug: 'smile-makeovers', href: '/services/smile-makeovers', desc: 'Combine veneers, whitening, and implants for a totally new look. Plan your dream smile with Dr. Sista.' },
  { name: 'Teeth Whitening', slug: 'teeth-whitening', href: '/services/teeth-whitening', desc: 'Get a brighter, whiter smile in one visit. Professional-grade whitening is safer and more effective than DIY kits.' },
  { name: 'TMJ Therapy', slug: 'tmj-therapy', href: '/services/tmj-therapy', desc: 'Suffering from jaw clicking or headaches? Dr. Sista offers non-invasive therapies for TMJ disorder relief.' },
  { name: 'Tooth Extraction', slug: 'tooth-extraction', href: '/services/tooth-extraction', desc: 'Damaged or painful tooth? We perform gentle extractions when necessary. Discuss replacement options immediately.' },
  { name: 'Wisdom Tooth Extraction', slug: 'wisdom-tooth-extraction', href: '/services/wisdom-tooth-extraction', desc: 'Impacted wisdom teeth causing pain? Safe and gentle removal by Dr. Sista. IV Sedation available for comfort.' },
