---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'



const navLinks = [
  { label: 'New Patients: Start Here', href: '/about' },
]

const serviceLinks = [
  { label: '3D Printing', href: '/services/3d-printing' },
  { label: 'All-On-4 Dental Implants', href: '/services/all-on-4-dental-implants' },
  { label: 'Bone and Soft Tissue Grafting', href: '/services/bone-and-soft-tissue-grafting' },
  { label: 'Bone Grafting', href: '/services/bone-grafting' },
  { label: 'CBCT Scanner', href: '/services/cbct-scanner' },
  { label: 'CEREC Same Day Crowns', href: '/services/cerec-same-day-crowns' },
]

const phone = '(713) 526-2904'
const phoneHref = 'tel:+17135262904'
---

<header
  class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-100"
  x-data="{ mobileOpen: false }"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo / Practice Name -->
      <a
        href="/"
        class="flex-shrink-0 font-serif text-xl font-bold tracking-tight text-neutral-dark hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
        aria-label="Dentiq Dentistry — home"
      >
        Dentiq Dentistry
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8" aria-label="Primary navigation">

        <!-- Services Dropdown -->
        <div class="relative group" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
          <button
            class="flex items-center gap-1 text-sm font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
            :aria-expanded="open"
            aria-haspopup="true"
          >
            Services
            <svg
              class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200"
              :class="{ 'rotate-180': open }"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Dropdown panel — pt-2 bridges the hover gap -->
          <div
            class="absolute top-full left-0 pt-2 w-64"
            x-show="open"
            x-transition:enter="transition ease-out duration-150"
            x-transition:enter-start="opacity-0 -translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-100"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-1"
            style="display: none;"
          >
            <div class="bg-white rounded-xl shadow-md ring-1 ring-neutral-100 py-2 overflow-hidden">
              {serviceLinks.map(link => (
                <a
                  href={link.href}
                  class="block px-4 py-2.5 text-sm font-medium text-neutral-dark hover:bg-brand-primary/5 hover:text-brand-primary transition-all duration-150 whitespace-nowrap"
                >
                  {link.label}
                </a>
              ))}
              <div class="mx-4 my-1.5 border-t border-neutral-100"></div>
              <a
                href="/services"
                class="block px-4 py-2.5 text-sm font-semibold text-brand-primary hover:bg-brand-primary/5 transition-all duration-150 whitespace-nowrap"
              >
                All Services →
              </a>
            </div>
          </div>
        </div>

        <!-- Top-level links -->
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-sm font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
          >
            {link.label}
          </a>
        ))}

        <!-- Phone -->
        <a
          href={phoneHref}
          class="tabular-nums text-sm font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 whitespace-nowrap min-h-[44px] flex items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
          aria-label={`Call us at ${phone}`}
        >
          {phone}
        </a>

        <!-- Book Appointment CTA -->
        <a
          href="/schedule"
          class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-center hover:opacity-90 whitespace-nowrap ml-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
        >
          Book Appointment
        </a>
      </nav>

      <!-- Mobile: phone + hamburger -->
      <div class="flex md:hidden items-center gap-3">
        <a
          href={phoneHref}
          class="tabular-nums text-sm font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 min-h-[44px] min-w-[44px] flex items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
          aria-label={`Call us at ${phone}`}
        >
          {phone}
        </a>

        <button
          class="min-h-[44px] min-w-[44px] flex items-center justify-center text-neutral-dark hover:text-brand-primary transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
          @click="mobileOpen = !mobileOpen"
          :aria-expanded="mobileOpen"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <path
              x-show="!mobileOpen"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              d="M4 6h16M4 12h16M4 18h16"
              style="display: block;"
            />
            <path
              x-show="mobileOpen"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              d="M6 6l12 12M18 6L6 18"
              style="display: none;"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div
    class="md:hidden border-t border-neutral-100 bg-white"
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    style="display: none;"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-col gap-1">

      <!-- Mobile: Services group -->
      <div x-data="{ servicesOpen: false }">
        <button
          class="w-full flex items-center justify-between py-3 text-sm font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
          @click="servicesOpen = !servicesOpen"
          :aria-expanded="servicesOpen"
        >
          Services
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200"
            :class="{ 'rotate-180': servicesOpen }"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div
          x-show="servicesOpen"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          class="pl-4 pb-2 flex flex-col gap-0.5"
          style="display: none;"
        >
          {serviceLinks.map(link => (
            <a
              href={link.href}
              class="py-2.5 text-sm font-medium text-neutral-dark hover:text-brand-primary transition-all duration-150 whitespace-nowrap"
            >
              {link.label}
            </a>
          ))}
          <a
            href="/services"
            class="py-2.5 text-sm font-semibold text-brand-primary hover:underline transition-all duration-150"
          >
            All Services →
          </a>
        </div>
      </div>

      <!-- Mobile: top-level links -->
      {navLinks.map(link => (
        <a
          href={link.href}
          class="py-3 text-sm font-semibold text-neutral-dark hover:text-brand-primary transition-all duration-200 border-t border-neutral-50"
        >
          {link.label}
        </a>
      ))}

      <!-- Mobile: CTA -->
      <div class="pt-4 pb-2">
        <a
          href="/schedule"
          class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-center hover:opacity-90 w-full"
        >
          Book Appointment
        </a>
      </div>
    </div>
  </div>
</header>