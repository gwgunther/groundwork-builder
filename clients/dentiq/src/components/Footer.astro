---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'



const currentYear = new Date().getFullYear()

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Blog', href: '/blog' },
  { label: 'Schedule', href: '/schedule' },
]

const socialLinks = [
  {
    label: 'Google Reviews',
    href: 'https://www.google.com/maps/place/Dentiq+Dentistry/@29.7528012,-95.3976363,15z/data=!4m5!3m4!1s0x0:0x29dc8ade446d2c07!8m2!3d29.7528012!4d-95.3976363',
    icon: 'google',
  },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/dentiqdentistry/',
    icon: 'facebook',
  },
]
---

<footer class="w-full bg-neutral-dark text-white">

  <!-- Editorial split top -->
  <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">

    <!-- Left column: practice identity -->
    <div class="flex flex-col gap-6">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary mb-3">
          Houston's Neighborhood Practice
        </p>
        <h2 class="font-serif text-3xl md:text-4xl font-bold leading-tight tracking-tight text-white">
          {site.name}
        </h2>
      </div>

      <p class="text-base leading-relaxed text-neutral-400 max-w-sm">
        Thoughtful, unhurried dental care in the heart of Houston — where your comfort and long-term health come first.
      </p>

      <!-- Address block -->
      <address class="not-italic flex flex-col gap-1 text-base leading-relaxed text-neutral-400">
        <span>{addr.street}</span>
        <span>{addr.city}, {addr.state} {addr.zip}</span>
        <a
          href={`tel:${site.phone.replace(/\D/g, '')}`}
          class="mt-2 text-white font-semibold hover:text-brand-primary transition-all duration-200 inline-block min-h-[44px] flex items-center"
          aria-label={`Call Dentiq Dentistry at ${site.phone}`}
        >
          {site.phone}
        </a>
      </address>

      <!-- Social links -->
      <div class="flex items-center gap-4 mt-2">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit Dentiq Dentistry on ${link.label}`}
            class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-400 hover:text-brand-primary transition-all duration-200 border border-neutral-700 hover:border-brand-primary rounded-lg px-4 py-2"
          >
            {link.icon === 'google' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
            )}
            {link.icon === 'facebook' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            )}
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Right column: navigation + hours divider -->
    <div class="flex flex-col gap-10 md:pl-8 md:border-l md:border-neutral-700">

      <!-- Navigation -->
      <nav aria-label="Footer navigation">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary mb-4">
          Navigate
        </p>
        <ul class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-base font-medium text-neutral-400 hover:text-white transition-all duration-200 inline-block"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Divider rule — brand gold accent -->
      <div class="w-12 h-px bg-brand-primary" aria-hidden="true"></div>

      <!-- Schedule CTA -->
      <div class="flex flex-col gap-4">
        <p class="text-base leading-relaxed text-neutral-400">
          Ready to book your next visit? We're accepting new patients at our West Gray location.
        </p>
        <a
          href="/schedule"
          class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-center hover:opacity-90 self-start"
        >
          Book Appointment
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-neutral-700">
    <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-neutral-500 text-center sm:text-left">
        &copy; {currentYear} {site.name}. All rights reserved.
      </p>
      <p class="text-sm text-neutral-500 text-center sm:text-right">
        1355 W Gray St &middot; Houston, TX &middot;
        <a
          href={`tel:${site.phone.replace(/\D/g, '')}`}
          class="text-neutral-400 hover:text-brand-primary transition-all duration-200"
        >
          {site.phone}
        </a>
      </p>
    </div>
  </div>

</footer>