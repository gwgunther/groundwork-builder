---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Prosthodontics & Restorative Dentistry",
  "description": "Learn more about replacement teeth, dentures, and other prosthodontic services from Bear Creek Family Dentistry.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Bear Creek Family Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Dallas"
    }
  }
};
---

<BaseLayout
  title={`Prosthodontics Dallas | ${site.name}`}
  description="Learn more about replacement teeth, dentures, and other prosthodontic services from Bear Creek Family Dentistry."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Prosthodontics &amp; Restorative Dentistry
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Learn more about replacement teeth, dentures, and other prosthodontic services from Bear Creek Family Dentistry.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">When dental damage or decay occurs, we may need to provide restorative dentistry services. We believe in conservative treatments that preserve the greatest amount of natural tooth structure while providing the best functional and aesthetic outcome possible. Our prosthodontists specialize in repairing and replacing teeth using solutions like dental crowns, bridges, tooth-colored fillings, dentures, and dental implants. Whether you need to restore a single damaged tooth or replace a full arch of missing teeth, Bear Creek Family Dentistry has the specialists and the technology to help you achieve a healthy, complete smile — all under one roof.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Prosthodontists complete four years of dental school plus an extra three years of specialized training in an ADA-accredited graduate program.</p>
      <p>Prosthodontists have advanced training in implant dentistry, TMD-jaw joint problems, traumatic injuries to mouth structures, congenital or birth anomalies to teeth, snoring, sleep disorders, and oral cancer reconstruction and continuing care.</p>
      <p>Services include dental crowns, dental bridges, tooth-colored fillings, dentures and partials, and root canal therapy.</p>
      <p>Prosthodontists are considered experts in oral rehabilitation.</p>
      <p>Prosthodontists regularly lead teams of general dentists, specialists, and other health professionals to develop solutions for dental needs.</p>
    </div>
  </section>
</BaseLayout>
