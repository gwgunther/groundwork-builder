---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Implant Dentures – DFW Metroplex",
  "description": "Enjoy the security of dental implants combined with the full smile restoration of dentures at Bear Creek Family Dentistry.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Bear Creek Family Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Dallas"
    }
  }
};
---

<BaseLayout
  title={`Implant Dentures Dallas | ${site.name}`}
  description="Enjoy the security of dental implants combined with the full smile restoration of dentures at Bear Creek Family Dentistry."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Implant Dentures – DFW Metroplex
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Enjoy the security of dental implants combined with the full smile restoration of dentures at Bear Creek Family Dentistry.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Implant dentures offer the best of both worlds: the comprehensive coverage of traditional dentures combined with the stability and bone-preserving benefits of dental implants. Instead of resting on the gums, implant-supported dentures are anchored to titanium posts placed in your jawbone — eliminating the slipping and shifting that can come with conventional dentures. The result is a restoration that looks natural, stays in place, and allows you to eat and speak with confidence. Our team at Bear Creek Family Dentistry includes the specialists needed to complete your implant denture treatment from start to finish, all under one roof.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Supported directly to the jawbone via dental implants rather than relying on gums or other nearby teeth.</p>
      <p>Metal posts help promote stronger bone tissue and prevent jawbone deterioration.</p>
      <p>Can help regain more than 80% of natural biting power.</p>
      <p>Designed to last for decades to even a lifetime with proper care.</p>
      <p>Patients will need four to six dental implant posts to support a partial or full denture.</p>
      <p>Practice uses the minimum number of implants possible to achieve adequate support.</p>
    </div>
  </section>
</BaseLayout>
