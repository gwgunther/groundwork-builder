---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Implant Bridge – DFW Metroplex",
  "description": "Replace multiple consecutive missing teeth with an implant-supported bridge for lasting stability and a natural-looking result.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Bear Creek Family Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Dallas"
    }
  }
};
---

<BaseLayout
  title={`Implant Bridge Dallas | ${site.name}`}
  description="Replace multiple consecutive missing teeth with an implant-supported bridge for lasting stability and a natural-looking result."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Implant Bridge – DFW Metroplex
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Replace multiple consecutive missing teeth with an implant-supported bridge for lasting stability and a natural-looking result.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">An implant bridge combines the strength and permanence of dental implants with the span of a traditional bridge to replace multiple consecutive missing teeth. Rather than relying on neighboring natural teeth for support, an implant bridge is anchored by titanium implant posts placed directly in the jawbone — providing a stable, long-lasting solution that feels and functions like your natural smile. At Bear Creek Family Dentistry, our oral surgeons and prosthodontists work together to plan and place your implant bridge, all within our comfortable DFW Metroplex offices.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed space-y-4">
      <p>Ideal option when missing several adjacent teeth.</p>
      <p>Does not require alterations to nearby natural teeth.</p>
      <p>Titanium posts are placed into the jawbone to serve as new tooth roots which support the restoration.</p>
      <p>Can prevent jawbone deterioration.</p>
      <p>Provides greater stability and longevity compared to a traditional bridge.</p>
      <p>Implant bridges tend to last for decades, if not a lifetime.</p>
    </div>
  </section>
</BaseLayout>
