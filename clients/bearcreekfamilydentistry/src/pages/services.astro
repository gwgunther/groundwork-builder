---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import { site, localBusinessSchema } from '../config/site';

// TODO: Customize services for the practice
const services = [
  { name: 'Adult Dentistry', slug: 'adult-dentistry', href: '/services/adult-dentistry', desc: 'Keep the whole family smiling with adult dentistry services including dental checkups and periodontal therapy from Bear Creek Family Dentistry.' },
  { name: 'Bone Grafting', slug: 'bone-grafting', href: '/services/bone-grafting', desc: 'Rebuild and strengthen your jawbone to support dental implants and protect your long-term oral health.' },
  { name: 'Dental Bridges', slug: 'dental-bridges', href: '/services/dental-bridges', desc: 'Missing one or more teeth in a row? At Bear Creek Family Dentistry, we can replace what you\'ve lost with personalized and lifelike dental bridges!' },
  { name: 'Dental Checkups and Cleanings', slug: 'dental-checkups-and-cleanings', href: '/services/dental-checkups-and-cleanings', desc: 'Contact Bear Creek Family Dentistry in Dallas, TX to learn how a dental checkup and cleaning can protect and preserve your smile!' },
  { name: 'Dental Crowns', slug: 'dental-crowns', href: '/services/dental-crowns', desc: 'If you have a severely decayed or damaged tooth, the team at Bear Creek Family Dentistry in Dallas, TX can preserve it with a dental crown!' },
  { name: 'Dental Implants', slug: 'dental-implants', href: '/services/dental-implants', desc: 'Replace any number of missing teeth with dental implant tooth replacement at Bear Creek Family Dentistry, your trusted DFW Metroplex office.' },
  { name: 'Dental Sealants', slug: 'dental-sealants', href: '/services/dental-sealants', desc: 'Protect your child\'s teeth from cavities with fast and comfortable dental sealants at Bear Creek Family Dentistry.' },
  { name: 'Dentures', slug: 'dentures', href: '/services/dentures', desc: 'Are you missing some or all of your teeth? At Bear Creek Family Dentistry, we can provide custom dentures in the DFW Metroplex to restore smiles.' },
  { name: 'Digital X-Rays', slug: 'digital-x-rays', href: '/services/digital-x-rays', desc: 'Modern digital X-ray technology helps our team see the full picture of your oral health quickly, comfortably, and with minimal radiation.' },
  { name: 'Full Dentures', slug: 'full-dentures', href: '/services/full-dentures', desc: 'Restore your complete smile with custom full dentures crafted to fit comfortably and look natural at Bear Creek Family Dentistry.' },
  { name: 'Gum Disease Therapy', slug: 'gum-disease-therapy', href: '/services/gum-disease-therapy', desc: 'Do you have sensitive or bleeding gums? Learn about the hidden perils of gum disease and what your dentist can do to help keep you healthy.' },
  { name: 'Implant Bridge', slug: 'implant-bridge', href: '/services/implant-bridge', desc: 'Replace multiple consecutive missing teeth with an implant-supported bridge for lasting stability and a natural-looking result.' },
  { name: 'Implant Dentures', slug: 'implant-dentures', href: '/services/implant-dentures', desc: 'Enjoy the security of dental implants combined with the full smile restoration of dentures at Bear Creek Family Dentistry.' },
  { name: 'Intraoral Cameras', slug: 'intraoral-cameras', href: '/services/intraoral-cameras', desc: 'See your smile the way we do with intraoral camera technology at Bear Creek Family Dentistry.' },
  { name: 'Oral Surgery', slug: 'oral-surgery', href: '/services/oral-surgery', desc: 'Find out more about oral surgery solutions available from Bear Creek Family Dentistry with several convenient locations in the DFW Metroplex.' },
  { name: 'Orthodontics', slug: 'orthodontics', href: '/services/orthodontics', desc: 'Learn more about orthodontic solutions available from Bear Creek Family Dentistry, your trusted DFW Metroplex dentist and team.' },
  { name: 'Partial Dentures', slug: 'partial-dentures', href: '/services/partial-dentures', desc: 'Replace select missing teeth with custom partial dentures designed to blend naturally with your existing smile.' },
  { name: 'Pediatric Dentistry', slug: 'pediatric-dentistry', href: '/services/pediatric-dentistry', desc: 'Trust your child\'s smile to the skilled DFW Metroplex dentists and team at Bear Creek Family Dentistry.' },
  { name: 'Prosthodontics', slug: 'prosthodontics', href: '/services/prosthodontics', desc: 'Learn more about replacement teeth, dentures, and other prosthodontic services from Bear Creek Family Dentistry.' },
  { name: 'Root Canal Treatment', slug: 'root-canal-treatment', href: '/services/root-canal-treatment', desc: 'Root canal treatment may be the best way to keep your tooth healthy and functional. Here\'s how Bear Creek Family Dental can repair your grin after se' },
  { name: 'Scaling and Root Planing', slug: 'scaling-and-root-planing', href: '/services/scaling-and-root-planing', desc: 'Deep cleaning therapy to remove built-up plaque and tartar below the gumline and help your gums heal.' },
  { name: 'Special Needs Dentistry', slug: 'special-needs-dentistry', href: '/services/special-needs-dentistry', desc: 'Do you or your child have special needs that make getting dental care difficult? We are happy to provide accommodation to meet your needs.' },
  { name: 'Tooth Extractions', slug: 'tooth-extractions', href: '/services/tooth-extractions', desc: 'Looking for toothache relief? Bear Creek Family Dentistry can help families in the DFW area with comprehensive tooth extractions and wisdom tooth remo' },
  { name: 'Tooth-Colored Fillings', slug: 'tooth-colored-fillings', href: '/services/tooth-colored-fillings', desc: 'Need to address a cavity? At Bear Creek Family Dentistry, we can restore your oral health with tooth-colored fillings in DFW Metroplex.' },
  { name: 'Wisdom Tooth Extraction', slug: 'wisdom-tooth-extraction', href: '/services/wisdom-tooth-extraction', desc: 'Wisdom tooth removal can prevent breakage, cavities, gum disease and unsightly crowding that could cause painful bite problems.' },
  { name: 'Your Child\'s First Visit', slug: 'your-child-s-first-visit', href: '/services/your-child-s-first-visit', desc: 'Help your child start their dental journey on the right foot with a warm, welcoming first visit at Bear Creek Family Dentistry.' },
];
---

<BaseLayout
  title={`Services — ${site.name}`}
  description={`Comprehensive dental services at ${site.name}. General dentistry, cosmetic treatments, dental implants, and restorations. Call ${site.phone}.`}
  schema={localBusinessSchema}
>
  <section class="bg-surface-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="section-heading mb-6">Our Services</h1>
        <p class="text-lg text-neutral-mid leading-relaxed">
          From routine checkups to advanced restorations, we provide a full range of dental services to keep your smile healthy and beautiful.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((service) => (
          <a href={service.href || `/services/${service.slug}`} class="card hover:border-brand-primary/30 transition-colors group">
            <h2 class="font-serif text-xl font-semibold text-neutral-dark mb-2 group-hover:text-brand-primary transition-colors">{service.name}</h2>
            <p class="text-neutral-mid">{service.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CTABlock phone={site.phone} />
    </div>
  </section>
</BaseLayout>
