---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'


---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-100">
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16"
    aria-label="Main navigation"
  >
    <!-- Logo / Practice Name -->
    <a
      href="/"
      class="flex-shrink-0 font-serif text-lg font-bold leading-tight text-neutral-dark hover:text-brand-primary transition-all duration-200"
      aria-label="Bear Creek Family Dentistry — home"
    >
      Bear Creek<br class="hidden sm:block" />
      <span class="text-brand-primary">Family Dentistry</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex items-center gap-8" x-data>
      <!-- About -->
      <a
        href="/about"
        class="whitespace-nowrap text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-200"
      >
        About
      </a>

      <!-- Services Dropdown -->
      <div class="relative group">
        <button
          class="whitespace-nowrap flex items-center gap-1 text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-200"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg
            class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"
            />
          </svg>
        </button>

        <!-- Dropdown panel — pt-2 bridges hover gap, no mt -->
        <div
          class="absolute top-full left-0 pt-2 w-64 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 z-50"
        >
          <div class="bg-white shadow-md rounded-xl border border-neutral-100 py-2 overflow-hidden">
            <a
              href="/services/adult-dentistry"
              class="whitespace-nowrap block px-4 py-2 text-sm text-neutral-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-all duration-150"
            >
              Adult Dentistry
            </a>
            <a
              href="/services/bone-grafting"
              class="whitespace-nowrap block px-4 py-2 text-sm text-neutral-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-all duration-150"
            >
              Bone Grafting
            </a>
            <a
              href="/services/dental-bridges"
              class="whitespace-nowrap block px-4 py-2 text-sm text-neutral-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-all duration-150"
            >
              Dental Bridges
            </a>
            <a
              href="/services/dental-checkups-and-cleanings"
              class="whitespace-nowrap block px-4 py-2 text-sm text-neutral-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-all duration-150"
            >
              Dental Checkups &amp; Cleanings
            </a>
            <a
              href="/services/dental-crowns"
              class="whitespace-nowrap block px-4 py-2 text-sm text-neutral-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-all duration-150"
            >
              Dental Crowns
            </a>
            <a
              href="/services/dental-implants"
              class="whitespace-nowrap block px-4 py-2 text-sm text-neutral-700 hover:bg-brand-primary/5 hover:text-brand-primary transition-all duration-150"
            >
              Dental Implants
            </a>
            <div class="border-t border-neutral-100 mt-1 pt-1">
              <a
                href="/services"
                class="whitespace-nowrap block px-4 py-2 text-sm font-semibold text-brand-primary hover:bg-brand-primary/5 transition-all duration-150"
              >
                All Services →
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Blog -->
      <a
        href="/blog"
        class="whitespace-nowrap text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-200"
      >
        Blog
      </a>
    </div>

    <!-- Desktop right: phone + CTA -->
    <div class="hidden lg:flex items-center">
      <a
        href="tel:+18886762327"
        class="tabular-nums whitespace-nowrap text-sm font-medium text-neutral-700 hover:text-brand-primary transition-all duration-200 min-h-[44px] flex items-center"
        aria-label="Call Bear Creek Family Dentistry at (888) 676-2327"
      >
        (888) 676-2327
      </a>
      <a
        href="/schedule"
        class="ml-6 inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-center hover:opacity-90 whitespace-nowrap"
      >
        Book Appointment
      </a>
    </div>

    <!-- Mobile: phone icon + hamburger -->
    <div class="flex lg:hidden items-center gap-3" x-data="{ open: false }">
      <a
        href="tel:+18886762327"
        class="tabular-nums flex items-center justify-center min-w-[44px] min-h-[44px] text-brand-primary hover:text-brand-primary/80 transition-all duration-200"
        aria-label="Call us at (888) 676-2327"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.56.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.25 1.01l-2.2 2.21z"
          />
        </svg>
      </a>

      <button
        @click="open = !open"
        class="flex items-center justify-center min-w-[44px] min-h-[44px] text-neutral-700 hover:text-brand-primary transition-all duration-200"
        :aria-expanded="open.toString()"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg
          x-show="!open"
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          x-show="open"
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Mobile Menu Panel -->
      <div
        id="mobile-menu"
        x-show="open"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="absolute top-full left-0 right-0 bg-white border-t border-neutral-100 shadow-md z-50 px-4 py-6 flex flex-col gap-1"
        @click.outside="open = false"
      >
        <a
          href="/about"
          class="block px-3 py-3 text-base font-medium text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
        >
          About
        </a>

        <!-- Mobile Services accordion -->
        <div x-data="{ servicesOpen: false }">
          <button
            @click="servicesOpen = !servicesOpen"
            class="w-full flex items-center justify-between px-3 py-3 text-base font-medium text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
            :aria-expanded="servicesOpen.toString()"
          >
            Services
            <svg
              class="w-4 h-4 transition-transform duration-200"
              :class="servicesOpen ? 'rotate-180' : ''"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
          <div
            x-show="servicesOpen"
            x-transition:enter="transition ease-out duration-150"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            class="pl-4 flex flex-col gap-1 mt-1"
          >
            <a
              href="/services/adult-dentistry"
              class="block px-3 py-2 text-sm text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
            >
              Adult Dentistry
            </a>
            <a
              href="/services/bone-grafting"
              class="block px-3 py-2 text-sm text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
            >
              Bone Grafting
            </a>
            <a
              href="/services/dental-bridges"
              class="block px-3 py-2 text-sm text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
            >
              Dental Bridges
            </a>
            <a
              href="/services/dental-checkups-and-cleanings"
              class="block px-3 py-2 text-sm text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
            >
              Dental Checkups &amp; Cleanings
            </a>
            <a
              href="/services/dental-crowns"
              class="block px-3 py-2 text-sm text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
            >
              Dental Crowns
            </a>
            <a
              href="/services/dental-implants"
              class="block px-3 py-2 text-sm text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
            >
              Dental Implants
            </a>
            <a
              href="/services"
              class="block px-3 py-2 text-sm font-semibold text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
            >
              All Services →
            </a>
          </div>
        </div>

        <a
          href="/blog"
          class="block px-3 py-3 text-base font-medium text-neutral-700 hover:text-brand-primary hover:bg-brand-primary/5 rounded-lg transition-all duration-150"
        >
          Blog
        </a>

        <div class="border-t border-neutral-100 mt-3 pt-4 flex flex-col gap-3">
          <a
            href="tel:+18886762327"
            class="tabular-nums flex items-center gap-2 px-3 py-3 text-base font-medium text-neutral-700 hover:text-brand-primary transition-all duration-150 min-h-[44px]"
            aria-label="Call (888) 676-2327"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-brand-primary flex-shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.56.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.25 1.01l-2.2 2.21z"
              />
            </svg>
            (888) 676-2327
          </a>
          <a
            href="/schedule"
            class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-center hover:opacity-90"
          >
            Book Appointment
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>