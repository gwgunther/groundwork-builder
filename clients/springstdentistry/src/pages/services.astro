---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import { site, localBusinessSchema } from '../config/site';

// TODO: Customize services for the practice
const services = [
  { name: 'Clear Aligners', slug: 'clear-aligners', href: '/services/clear-aligners', desc: 'A discreet, comfortable way to straighten your smile — no metal required.' },
  { name: 'Cosmetic Dentistry', slug: 'cosmetic-dentistry', href: '/services/cosmetic-dentistry', desc: 'Spring St. Dentistry provides cosmetic dentistry in Long Beach. Schedule an appointment with our Long Beach cosmetic dentist.' },
  { name: 'Deep Cleaning', slug: 'deep-cleaning', href: '/services/deep-cleaning', desc: 'Thorough periodontal care to get your gum health back on track.' },
  { name: 'Dental Bonding', slug: 'dental-bonding', href: '/services/dental-bonding', desc: 'A quick, affordable cosmetic fix for chips, gaps, and minor imperfections.' },
  { name: 'Dental Bridges', slug: 'dental-bridges', href: '/services/dental-bridges', desc: 'Restore your smile and your confidence with a natural-looking bridge.' },
  { name: 'Dental Crowns', slug: 'dental-crowns', href: '/services/dental-crowns', desc: 'Spring St. Dentistry provides dental crowns in Long Beach. Schedule an appointment with our Long Beach dentist.' },
  { name: 'Dental Exam & Cleaning', slug: 'dental-exam-cleaning', href: '/services/dental-exam-cleaning', desc: 'Spring St. Dentistry provides dental exams and cleanings in Long Beach — schedule your visit today.' },
  { name: 'Dental Fillings', slug: 'dental-fillings', href: '/services/dental-fillings', desc: 'Spring St. Dentistry provides dental fillings in Long Beach. Schedule an appointment with our Long Beach dentist.' },
  { name: 'Dental Implants', slug: 'dental-implants', href: '/services/dental-implants', desc: 'Spring St. Dentistry provides dental implants in Long Beach — call to find out if you\'re a candidate.' },
  { name: 'Dental Veneers', slug: 'dental-veneers', href: '/services/dental-veneers', desc: 'Thin, custom-crafted porcelain shells that transform the look of your smile.' },
  { name: 'Extractions', slug: 'extractions', href: '/services/extractions', desc: 'Gentle, same-day extractions when saving a tooth isn\'t possible.' },
  { name: 'Family Dentistry', slug: 'family-dentistry', href: '/services/family-dentistry', desc: 'Spring St. Dentistry provides family dentistry in Long Beach for adults and children.' },
  { name: 'General Dentistry', slug: 'general-dentistry', href: '/services/general-dentistry', desc: 'Spring St. Dentistry provides general dentistry in Long Beach — schedule your appointment today.' },
  { name: 'Invisalign', slug: 'invisalign', href: '/services/invisalign', desc: 'Straighten your smile discreetly with Invisalign clear aligner therapy.' },
  { name: 'LANAP', slug: 'lanap', href: '/services/lanap', desc: 'Laser-assisted gum disease treatment — less discomfort, faster healing.' },
  { name: 'Laser-Assisted Periodontal Therapy', slug: 'laser-assisted-periodontal-therapy', href: '/services/laser-assisted-periodontal-therapy', desc: 'Advanced laser treatment to address gum disease with precision and comfort.' },
  { name: 'Orthodontics', slug: 'orthodontics', href: '/services/orthodontics', desc: 'Spring St. Dentistry provides orthodontics in Long Beach — schedule an appointment with our team.' },
  { name: 'Periodontics', slug: 'periodontics', href: '/services/periodontics', desc: 'Specialized gum care — from early-stage gum disease to advanced periodontal treatment.' },
  { name: 'Porcelain Crowns', slug: 'porcelain-crowns', href: '/services/porcelain-crowns', desc: 'Beautiful, natural-looking crowns that restore both function and appearance.' },
  { name: 'Root Canal', slug: 'root-canal', href: '/services/root-canal', desc: 'Spring St. Dentistry provides root canal treatment in Long Beach — call to schedule your appointment.' },
  { name: 'Root Scaling and Planing', slug: 'root-scaling-and-planing', href: '/services/root-scaling-and-planing', desc: 'A thorough, non-surgical treatment to address gum disease below the gumline.' },
  { name: 'Same Day Emergency Treatment', slug: 'same-day-emergency-treatment', href: '/services/same-day-emergency-treatment', desc: 'Tooth pain, broken teeth, or a dental emergency? Call us — we\'re here to help.' },
  { name: 'Teeth Whitening', slug: 'teeth-whitening', href: '/services/teeth-whitening', desc: 'Spring St. Dentistry provides professional teeth whitening in Long Beach — schedule your appointment today.' },
  { name: 'Traditional Metal Braces', slug: 'traditional-metal-braces', href: '/services/traditional-metal-braces', desc: 'Tried-and-true orthodontic treatment that gets reliable results for kids, teens, and adults.' },
];
---

<BaseLayout
  title={`Services — ${site.name}`}
  description={`Comprehensive dental services at ${site.name}. General dentistry, cosmetic treatments, dental implants, and restorations. Call ${site.phone}.`}
  schema={localBusinessSchema}
>
  <section class="bg-surface-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="section-heading mb-6">Our Services</h1>
        <p class="text-lg text-neutral-mid leading-relaxed">
          From routine checkups to advanced restorations, we provide a full range of dental services to keep your smile healthy and beautiful.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((service) => (
          <a href={service.href || `/services/${service.slug}`} class="card hover:border-brand-primary/30 transition-colors group">
            <h2 class="font-serif text-xl font-semibold text-neutral-dark mb-2 group-hover:text-brand-primary transition-colors">{service.name}</h2>
            <p class="text-neutral-mid">{service.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CTABlock phone={site.phone} />
    </div>
  </section>
</BaseLayout>
