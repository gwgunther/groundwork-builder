---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "LANAP in Long Beach",
  "description": "Spring St. Dentistry offers LANAP — laser-assisted new attachment procedure — in Long Beach for advanced gum disease treatment.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`LANAP Long Beach | ${site.name}`}
  description="Spring St. Dentistry offers LANAP — laser-assisted new attachment procedure — in Long Beach for advanced gum disease treatment."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      LANAP in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry offers LANAP — laser-assisted new attachment procedure — in Long Beach for advanced gum disease treatment.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">LANAP (Laser-Assisted New Attachment Procedure) is a minimally invasive, FDA-cleared treatment for gum disease. Instead of cutting away gum tissue the traditional way, LANAP uses a specialized laser to target and remove diseased tissue while leaving healthy tissue intact. It typically means less discomfort, less bleeding, and faster healing compared to conventional gum surgery. At Spring St. Dentistry, we're proud to offer this advanced approach to periodontal care — it's one of the things that sets our practice apart for patients dealing with more serious gum disease.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
