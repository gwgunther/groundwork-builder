---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Same-Day Emergency Dental Treatment in Long Beach",
  "description": "Spring St. Dentistry provides same-day emergency dental care in Long Beach. Call now for help with tooth pain, broken teeth, and more.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Same Day Emergency Treatment Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides same-day emergency dental care in Long Beach. Call now for help with tooth pain, broken teeth, and more."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Same-Day Emergency Dental Treatment in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides same-day emergency dental care in Long Beach. Call now for help with tooth pain, broken teeth, and more.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Dental emergencies don't wait for a convenient time — and neither do we. If you're dealing with a broken tooth, sudden tooth pain, a lost crown, or another urgent dental issue, call Spring St. Dentistry right away at (562) 420-8578. We provide same-day emergency treatment to get you out of pain and back to normal as quickly as possible. We can help with broken teeth, tooth pain, root canals, and extractions. Don't tough it out — let us help.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Call Now: (562) 420-8578</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
