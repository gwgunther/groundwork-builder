---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Root Canal in Long Beach",
  "description": "Spring St. Dentistry provides root canal treatment in Long Beach. Schedule an appointment with our Long Beach dentist.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Root Canal Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides root canal treatment in Long Beach. Schedule an appointment with our Long Beach dentist."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Root Canal in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides root canal treatment in Long Beach. Schedule an appointment with our Long Beach dentist.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">A root canal is a procedure specifically designed to save you from losing a tooth. Our teeth are made up of several parts — one of them being the pulp, which is where the nerve, blood vessels, and connective tissue live. When this area becomes inflamed or infected, a root canal becomes necessary to relieve the pain and protect the tooth. Signs that you may need a root canal include sharp pain in the middle of the night, a generalized headache that seems to start in a tooth, or a bump near the gumline with visible pus. If you're experiencing any of these symptoms, don't wait — call us at (562) 420-8578 so we can help.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Call Us Today</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
