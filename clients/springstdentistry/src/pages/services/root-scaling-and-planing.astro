---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Root Scaling and Planing in Long Beach",
  "description": "Spring St. Dentistry provides root scaling and planing in Long Beach as a key treatment for gum disease.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Root Scaling and Planing Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides root scaling and planing in Long Beach as a key treatment for gum disease."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Root Scaling and Planing in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides root scaling and planing in Long Beach as a key treatment for gum disease.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Root scaling and planing is a deep cleaning procedure that goes below the gumline to remove plaque, tartar, and bacteria from the surfaces of your tooth roots. When gum disease causes the gums to pull away from the teeth, buildup can accumulate in those pockets — and regular brushing and professional cleanings can't reach it. Scaling and planing smooths the root surfaces, making it harder for bacteria to reattach and giving your gums the best chance to heal and reattach properly. At Spring St. Dentistry, we work with each patient to find the right periodontal treatment for their situation. Call us at (562) 420-8578 to schedule an evaluation.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule an Evaluation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
