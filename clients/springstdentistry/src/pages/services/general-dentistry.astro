---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "General Dentist in Long Beach",
  "description": "Spring St. Dentistry provides general dentistry in Long Beach — schedule your appointment today.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`General Dentistry Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides general dentistry in Long Beach — schedule your appointment today."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      General Dentist in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides general dentistry in Long Beach — schedule your appointment today.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">At Spring St. Dentistry, we provide general dentistry services including the prevention, diagnosis, and treatment of a wide variety of conditions and diseases that affect your teeth and gums. Dr. Hoang and our team are committed to ensuring your oral health is in excellent condition. We work with each patient to establish a customized dental hygiene plan that incorporates dental exams, x-rays, thorough teeth cleanings, and scaling and deep cleaning when necessary — along with other diagnostic tools to help prevent and treat issues before they grow. If you have questions about the general dentistry services we provide, please call our office at (562) 420-8578.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule an Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
