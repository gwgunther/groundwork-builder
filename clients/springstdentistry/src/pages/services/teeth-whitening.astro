---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Teeth Whitening in Long Beach",
  "description": "Spring St. Dentistry provides teeth whitening in Long Beach. Schedule an appointment with our Long Beach dentist for professional teeth whitening.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Teeth Whitening Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides teeth whitening in Long Beach. Schedule an appointment with our Long Beach dentist for professional teeth whitening."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Teeth Whitening in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides teeth whitening in Long Beach. Schedule an appointment with our Long Beach dentist for professional teeth whitening.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Teeth whitening is one of the most popular cosmetic dentistry procedures — and one of the most straightforward ways to refresh your smile. Professional whitening is more effective than over-the-counter options and is tailored to your teeth for safer, more consistent results. At Spring St. Dentistry, we offer professional whitening services, and new patients can ask about our special offer that includes complimentary whitening trays and a take-home supply. If you'd like a brighter smile, call us at (562) 420-8578 or stop by the office.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Book Your Whitening Appointment</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
