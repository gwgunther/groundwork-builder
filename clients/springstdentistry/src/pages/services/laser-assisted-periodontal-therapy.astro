---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Laser-Assisted Periodontal Therapy in Long Beach",
  "description": "Spring St. Dentistry provides laser-assisted periodontal therapy in Long Beach for effective, minimally invasive gum disease treatment.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Laser-Assisted Periodontal Therapy Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides laser-assisted periodontal therapy in Long Beach for effective, minimally invasive gum disease treatment."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Laser-Assisted Periodontal Therapy in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides laser-assisted periodontal therapy in Long Beach for effective, minimally invasive gum disease treatment.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Laser-assisted periodontal therapy uses dental laser technology to treat gum disease with greater precision and less trauma to surrounding tissue than traditional methods. The laser targets infected tissue and harmful bacteria along and below the gumline, helping the gums heal more effectively. Patients often find that laser therapy involves less discomfort during and after treatment, and recovery tends to be quicker than with conventional gum surgery. At Spring St. Dentistry, we're committed to providing the kind of advanced periodontal care that helps you keep your teeth for the long term. Call us at (562) 420-8578 to find out if laser therapy is right for you.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
