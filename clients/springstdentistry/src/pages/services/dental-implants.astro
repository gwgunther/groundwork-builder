---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Implant Dentist in Long Beach",
  "description": "Spring St. Dentistry provides dental implants in Long Beach. Schedule an appointment with our Long Beach implant dentist.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Dental Implants Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides dental implants in Long Beach. Schedule an appointment with our Long Beach implant dentist."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Implant Dentist in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides dental implants in Long Beach. Schedule an appointment with our Long Beach implant dentist.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">If you have a missing tooth and it's impacting your comfort or your confidence, a dental implant could be your solution. Dental implants have had a considerable impact on modern dentistry — offering a highly viable way to replace a missing tooth with something that looks and functions like the real thing. A dental implant is essentially an artificial tooth root placed into your jaw, with a dental crown capped on top for a complete, natural-looking result. Spring St. Dentistry also includes Dr. Richard K. Lee, a board-certified periodontist, as part of our team — bringing specialized expertise to more complex implant cases. To find out whether you're a good candidate for dental implants, please call us at (562) 420-8578.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
