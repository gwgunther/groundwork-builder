---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "LANAP Treatment in Long Beach",
  "description": "Spring St. Dentistry provides LANAP laser gum treatment in Long Beach as an advanced option for periodontal care.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`LANAP Treatment Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides LANAP laser gum treatment in Long Beach as an advanced option for periodontal care."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      LANAP Treatment in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides LANAP laser gum treatment in Long Beach as an advanced option for periodontal care.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">LANAP — Laser-Assisted New Attachment Procedure — is an FDA-cleared laser treatment for gum disease that offers an alternative to traditional gum surgery. Using a specialized laser, the procedure targets diseased tissue and bacteria around the gumline with precision, helping to promote healing and reattachment of the gums to the tooth. Because it doesn't involve cutting or sutures, patients typically experience less discomfort and faster recovery compared to conventional periodontal surgery. At Spring St. Dentistry, LANAP is part of our commitment to offering advanced periodontal care right here in Long Beach. Call us at (562) 420-8578 to learn more.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Periodontal Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
