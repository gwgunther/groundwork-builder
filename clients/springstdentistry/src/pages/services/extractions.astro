---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Tooth Extractions in Long Beach",
  "description": "Spring St. Dentistry provides tooth extractions in Long Beach, including same-day care for dental emergencies.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Extractions Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides tooth extractions in Long Beach, including same-day care for dental emergencies."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Tooth Extractions in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides tooth extractions in Long Beach, including same-day care for dental emergencies.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Sometimes a tooth is too damaged or decayed to save, and an extraction is the safest path forward. At Spring St. Dentistry, we always try to preserve your natural tooth whenever possible — but when an extraction is necessary, we make sure you're comfortable and informed every step of the way. We also provide same-day emergency extractions for patients dealing with acute tooth pain or a dental crisis. If you're in pain and need help quickly, call us now at (562) 420-8578.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Call Us Today</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
