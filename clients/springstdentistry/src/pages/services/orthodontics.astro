---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Orthodontics in Long Beach",
  "description": "Spring St. Dentistry provides orthodontics in Long Beach. Schedule an appointment with our Long Beach orthodontics team.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Orthodontics Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides orthodontics in Long Beach. Schedule an appointment with our Long Beach orthodontics team."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Orthodontics in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides orthodontics in Long Beach. Schedule an appointment with our Long Beach orthodontics team.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Orthodontics are an excellent way to straighten your teeth — and the benefits go beyond a better-looking smile. Orthodontic treatment can also restore functionality to your teeth, jaw, and bite. At Spring St. Dentistry, we offer both traditional metal braces and Invisalign clear aligners, so you can choose the option that works best for your lifestyle. The American Association of Orthodontists (AAO) recommends that all children have an orthodontic evaluation by age 7, regardless of how many teeth have erupted. Early evaluation allows us to identify and address structural changes before they become more complex issues down the road.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule an Orthodontic Evaluation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
