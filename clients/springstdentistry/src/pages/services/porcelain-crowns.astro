---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Porcelain Crowns in Long Beach",
  "description": "Spring St. Dentistry offers porcelain crowns in Long Beach for a natural-looking restoration that blends seamlessly with your smile.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Porcelain Crowns Long Beach | ${site.name}`}
  description="Spring St. Dentistry offers porcelain crowns in Long Beach for a natural-looking restoration that blends seamlessly with your smile."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Porcelain Crowns in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry offers porcelain crowns in Long Beach for a natural-looking restoration that blends seamlessly with your smile.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Porcelain crowns offer all the strength and protection of a traditional dental crown with the added benefit of a completely natural appearance. Because porcelain closely mimics the color and translucency of real tooth enamel, a porcelain crown blends in beautifully with the teeth around it — making it an especially popular choice for visible teeth toward the front of your smile. At Spring St. Dentistry, we offer porcelain crowns as part of our cosmetic and restorative services, and we'll make sure your crown fits comfortably and looks exactly right.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
