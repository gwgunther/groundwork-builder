---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Dental Exam & Cleaning in Long Beach",
  "description": "Spring St. Dentistry provides Dental Exam & Cleaning in Long Beach. Schedule an appointment with our Long Beach dentist for a Dental Exam & Cleaning.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Exam & Cleaning Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides Dental Exam & Cleaning in Long Beach. Schedule an appointment with our Long Beach dentist for a Dental Exam & Cleaning."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Dental Exam &amp; Cleaning in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides Dental Exam &amp; Cleaning in Long Beach. Schedule an appointment with our Long Beach dentist for a Dental Exam &amp; Cleaning.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Regular dental cleanings and exams are vital to maintaining your oral health and preventing future complications. The American Dental Association (ADA) recommends that patients visit a dentist twice every year — and most insurance plans cover two visits as a result. A dental cleaning removes bacteria, tartar buildup, and plaque from the surface of your teeth, which is vital to keeping them in great health. At Spring St. Dentistry, your cleaning is also an opportunity for us to check in on your overall oral health and catch anything early. Your comfort matters every step of the way.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Book Your Visit</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
