---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Invisalign in Long Beach",
  "description": "Spring St. Dentistry provides Invisalign clear aligners in Long Beach as part of our orthodontic services.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Invisalign Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides Invisalign clear aligners in Long Beach as part of our orthodontic services."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Invisalign in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides Invisalign clear aligners in Long Beach as part of our orthodontic services.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Invisalign is a popular alternative to traditional braces that uses a series of clear, removable aligners to gradually straighten your teeth. If you'd like to improve your smile without metal brackets and wires, Invisalign may be a great fit. The aligners are nearly invisible and can be removed for eating and brushing, making them a convenient option for teens and adults alike. At Spring St. Dentistry, we offer Invisalign as part of our orthodontic services. Call us at (562) 420-8578 to find out if you're a candidate.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
