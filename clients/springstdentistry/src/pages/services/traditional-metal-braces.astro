---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Traditional Metal Braces in Long Beach",
  "description": "Spring St. Dentistry provides traditional metal braces in Long Beach as part of our orthodontic services.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Spring St. Dentistry",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Long Beach"
    }
  }
};
---

<BaseLayout
  title={`Traditional Metal Braces Long Beach | ${site.name}`}
  description="Spring St. Dentistry provides traditional metal braces in Long Beach as part of our orthodontic services."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Traditional Metal Braces in Long Beach
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Spring St. Dentistry provides traditional metal braces in Long Beach as part of our orthodontic services.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Traditional metal braces are the most common form of orthodontic treatment — and for good reason. They're highly efficient at correcting a wide range of issues with teeth alignment, bite, and jaw positioning. If you or your child need orthodontic treatment, metal braces are a time-tested option that delivers reliable results. At Spring St. Dentistry, we offer both traditional braces and Invisalign, so we can help you find the approach that fits your life. The American Association of Orthodontists recommends an evaluation by age 7 for children, so early is always better. Call us at (562) 420-8578 to schedule a consultation.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule an Orthodontic Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
