---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'


---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-100">
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16"
    aria-label="Primary navigation"
  >

    <!-- Logo / Practice Name -->
    <a
      href="/"
      class="font-serif font-bold text-xl text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 flex-shrink-0"
      aria-label="Spring St. Dentistry — home"
    >
      Spring St. Dentistry
    </a>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex items-center gap-8">

      <!-- Services Dropdown -->
      <div class="relative group" x-data="{ open: false }">
        <button
          @mouseenter="open = true"
          @mouseleave="open = false"
          @click="open = !open"
          @keydown.escape="open = false"
          :aria-expanded="open"
          aria-haspopup="true"
          class="flex items-center gap-1 text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2 rounded"
        >
          Services
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200"
            :class="open ? 'rotate-180' : ''"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Panel — pt-2 bridges hover gap, never mt-2 -->
        <div
          @mouseenter="open = true"
          @mouseleave="open = false"
          x-show="open"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-1"
          class="absolute top-full left-0 pt-2 w-56 z-50"
          role="menu"
          aria-label="Services menu"
          style="display: none;"
        >
          <div class="rounded-2xl bg-white shadow-md py-2 overflow-hidden">
            <a
              href="/services/clear-aligners"
              class="block px-4 py-2.5 text-sm font-medium text-neutral-dark whitespace-nowrap hover:bg-brand-primary hover:text-white transition-all duration-200"
              role="menuitem"
            >Clear Aligners</a>
            <a
              href="/services/cosmetic-dentistry"
              class="block px-4 py-2.5 text-sm font-medium text-neutral-dark whitespace-nowrap hover:bg-brand-primary hover:text-white transition-all duration-200"
              role="menuitem"
            >Cosmetic Dentistry</a>
            <a
              href="/services/deep-cleaning"
              class="block px-4 py-2.5 text-sm font-medium text-neutral-dark whitespace-nowrap hover:bg-brand-primary hover:text-white transition-all duration-200"
              role="menuitem"
            >Deep Cleaning</a>
            <a
              href="/services/dental-bonding"
              class="block px-4 py-2.5 text-sm font-medium text-neutral-dark whitespace-nowrap hover:bg-brand-primary hover:text-white transition-all duration-200"
              role="menuitem"
            >Dental Bonding</a>
            <a
              href="/services/dental-bridges"
              class="block px-4 py-2.5 text-sm font-medium text-neutral-dark whitespace-nowrap hover:bg-brand-primary hover:text-white transition-all duration-200"
              role="menuitem"
            >Dental Bridges</a>
            <a
              href="/services/dental-crowns"
              class="block px-4 py-2.5 text-sm font-medium text-neutral-dark whitespace-nowrap hover:bg-brand-primary hover:text-white transition-all duration-200"
              role="menuitem"
            >Dental Crowns</a>
            <div class="my-1 border-t border-neutral-100"></div>
            <a
              href="/services"
              class="block px-4 py-2.5 text-sm font-semibold text-brand-primary whitespace-nowrap hover:bg-brand-primary hover:text-white transition-all duration-200"
              role="menuitem"
            >All Services →</a>
          </div>
        </div>
      </div>

      <!-- Top-level links -->
      <a
        href="/blog"
        class="text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2 rounded"
      >Our Blog</a>

      <a
        href="/schedule"
        class="text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2 rounded"
      >New Patients</a>

      <a
        href="/about"
        class="text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2 rounded"
      >Meet Hoang</a>

    </div>

    <!-- Phone + CTA (desktop) -->
    <div class="hidden lg:flex items-center gap-4">
      <a
        href="tel:+15624208578"
        class="tabular-nums text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2 rounded min-h-11 inline-flex items-center"
        aria-label="Call Spring St. Dentistry at (562) 420-8578"
      >(562) 420-8578</a>

      <a
        href="/schedule"
        class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-2xl transition-all duration-200 text-center hover:opacity-90 whitespace-nowrap ml-6 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2"
      >Book Appointment</a>
    </div>

    <!-- Mobile: Phone + Hamburger -->
    <div class="flex lg:hidden items-center gap-3" x-data="{ mobileOpen: false }">

      <a
        href="tel:+15624208578"
        class="tabular-nums text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 min-h-11 min-w-11 inline-flex items-center justify-center focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2 rounded"
        aria-label="Call Spring St. Dentistry at (562) 420-8578"
      >(562) 420-8578</a>

      <!-- Hamburger button -->
      <button
        @click="mobileOpen = !mobileOpen"
        :aria-expanded="mobileOpen"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
        class="inline-flex items-center justify-center w-11 h-11 rounded-2xl text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2 flex-shrink-0"
      >
        <svg
          x-show="!mobileOpen"
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          x-show="mobileOpen"
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          style="display: none;"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Mobile Menu Panel -->
      <div
        id="mobile-menu"
        x-show="mobileOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        @keydown.escape.window="mobileOpen = false"
        class="absolute top-full left-0 right-0 bg-white border-t border-neutral-100 shadow-md z-50 px-4 py-4"
        style="display: none;"
        role="navigation"
        aria-label="Mobile navigation"
      >
        <div class="flex flex-col gap-1">

          <!-- Mobile Services accordion -->
          <div x-data="{ servicesOpen: false }">
            <button
              @click="servicesOpen = !servicesOpen"
              :aria-expanded="servicesOpen"
              class="w-full flex items-center justify-between px-3 py-3 text-sm font-semibold text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2"
            >
              Services
              <svg
                class="w-3.5 h-3.5 transition-transform duration-200"
                :class="servicesOpen ? 'rotate-180' : ''"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" />
              </svg>
            </button>

            <div
              x-show="servicesOpen"
              x-transition:enter="transition ease-out duration-150"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              class="pl-3 flex flex-col gap-0.5 mt-0.5"
              style="display: none;"
            >
              <a href="/services/clear-aligners"   class="block px-3 py-2.5 text-sm font-medium text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">Clear Aligners</a>
              <a href="/services/cosmetic-dentistry" class="block px-3 py-2.5 text-sm font-medium text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">Cosmetic Dentistry</a>
              <a href="/services/deep-cleaning"    class="block px-3 py-2.5 text-sm font-medium text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">Deep Cleaning</a>
              <a href="/services/dental-bonding"   class="block px-3 py-2.5 text-sm font-medium text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">Dental Bonding</a>
              <a href="/services/dental-bridges"   class="block px-3 py-2.5 text-sm font-medium text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">Dental Bridges</a>
              <a href="/services/dental-crowns"    class="block px-3 py-2.5 text-sm font-medium text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">Dental Crowns</a>
              <a href="/services" class="block px-3 py-2.5 text-sm font-semibold text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">All Services →</a>
            </div>
          </div>

          <a href="/blog"     class="block px-3 py-3 text-sm font-semibold text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">Our Blog</a>
          <a href="/schedule" class="block px-3 py-3 text-sm font-semibold text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">New Patients</a>
          <a href="/about"    class="block px-3 py-3 text-sm font-semibold text-neutral-dark hover:text-brand-primary hover:bg-neutral-50 rounded-xl transition-all duration-200">Meet Hoang</a>

          <div class="pt-3 border-t border-neutral-100 mt-2">
            <a
              href="/schedule"
              class="inline-block w-full bg-brand-primary text-white font-semibold px-6 py-3 rounded-2xl transition-all duration-200 text-center hover:opacity-90 focus-visible:outline-2 focus-visible:outline-brand-primary focus-visible:outline-offset-2"
            >Book Appointment</a>
          </div>
        </div>
      </div>

    </div>

  </nav>
</header>