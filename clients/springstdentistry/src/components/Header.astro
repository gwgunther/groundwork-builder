---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'


---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-100">
  <nav class="max-w-7xl mx-auto px-6 flex items-center justify-between h-16 gap-8">

    <!-- Logo / Practice Name -->
    <a
      href="/"
      class="font-serif text-xl font-bold text-neutral-dark whitespace-nowrap hover:opacity-80 transition-all duration-200 shrink-0"
      aria-label="Spring St. Dentistry — home"
    >
      Spring St. Dentistry
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-6 flex-1 justify-end">

      <!-- Services Dropdown -->
      <div class="relative group" x-data="{ open: false }">
        <button
          @mouseenter="open = true"
          @mouseleave="open = false"
          @click="open = !open"
          :aria-expanded="open"
          aria-haspopup="true"
          class="flex items-center gap-1 text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 py-2"
        >
          Services
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200"
            :class="open ? 'rotate-180' : ''"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Panel — pt-2 bridges hover gap, never mt-2 -->
        <div
          @mouseenter="open = true"
          @mouseleave="open = false"
          x-show="open"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-1"
          class="absolute top-full left-0 pt-2 w-56 z-50"
          style="display: none;"
        >
          <div class="rounded-2xl bg-white shadow-md p-4 flex flex-col gap-1">
            <a href="/services/clear-aligners"
               class="text-sm font-medium text-neutral-dark whitespace-nowrap px-3 py-2 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-200">
              Clear Aligners
            </a>
            <a href="/services/cosmetic-dentistry"
               class="text-sm font-medium text-neutral-dark whitespace-nowrap px-3 py-2 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-200">
              Cosmetic Dentistry
            </a>
            <a href="/services/deep-cleaning"
               class="text-sm font-medium text-neutral-dark whitespace-nowrap px-3 py-2 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-200">
              Deep Cleaning
            </a>
            <a href="/services/dental-bonding"
               class="text-sm font-medium text-neutral-dark whitespace-nowrap px-3 py-2 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-200">
              Dental Bonding
            </a>
            <a href="/services/dental-bridges"
               class="text-sm font-medium text-neutral-dark whitespace-nowrap px-3 py-2 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-200">
              Dental Bridges
            </a>
            <a href="/services/dental-crowns"
               class="text-sm font-medium text-neutral-dark whitespace-nowrap px-3 py-2 rounded-xl hover:bg-brand-primary/8 hover:text-brand-primary transition-all duration-200">
              Dental Crowns
            </a>
            <div class="border-t border-neutral-100 mt-1 pt-1">
              <a href="/services"
                 class="text-sm font-semibold text-brand-primary whitespace-nowrap px-3 py-2 rounded-xl hover:bg-brand-primary/8 transition-all duration-200 flex items-center gap-1">
                All Services
                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Top-level links -->
      <a href="/blog"
         class="text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 py-2">
        Our Blog
      </a>
      <a href="/schedule"
         class="text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 py-2">
        New Patients
      </a>
      <a href="/about"
         class="text-sm font-semibold text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 py-2">
        Meet Dr. Hoang
      </a>

      <!-- Phone -->
      <a
        href="tel:+15624208578"
        class="text-sm font-semibold tabular-nums text-neutral-dark whitespace-nowrap hover:text-brand-primary transition-all duration-200 py-2"
        aria-label="Call Spring St. Dentistry at (562) 420-8578"
      >
        (562) 420-8578
      </a>

      <!-- Book CTA -->
      <a
        href="/schedule"
        class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-2xl transition-all duration-200 text-center hover:opacity-90 whitespace-nowrap ml-6 shrink-0"
      >
        Book Appointment
      </a>
    </div>

    <!-- Mobile: phone + hamburger -->
    <div class="flex md:hidden items-center gap-4 ml-auto" x-data="{ mobileOpen: false }">
      <a
        href="tel:+15624208578"
        class="flex items-center justify-center w-11 h-11 rounded-full hover:bg-neutral-100 transition-all duration-200 text-brand-primary"
        aria-label="Call us at (562) 420-8578"
      >
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" clip-rule="evenodd" />
        </svg>
      </a>

      <button
        @click="mobileOpen = !mobileOpen"
        :aria-expanded="mobileOpen"
        aria-label="Toggle navigation menu"
        class="flex items-center justify-center w-11 h-11 rounded-full hover:bg-neutral-100 transition-all duration-200 text-neutral-dark"
      >
        <svg x-show="!mobileOpen" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg x-show="mobileOpen" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" style="display:none;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Mobile Drawer -->
      <div
        x-show="mobileOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="absolute top-full left-0 right-0 bg-white border-t border-neutral-100 shadow-md z-50 px-6 py-6 flex flex-col gap-1"
        style="display: none;"
        @click.outside="mobileOpen = false"
      >
        <!-- Services accordion in mobile -->
        <div x-data="{ servicesOpen: false }">
          <button
            @click="servicesOpen = !servicesOpen"
            :aria-expanded="servicesOpen"
            class="flex items-center justify-between w-full text-sm font-semibold text-neutral-dark py-3 hover:text-brand-primary transition-all duration-200"
          >
            Services
            <svg
              class="w-4 h-4 transition-transform duration-200"
              :class="servicesOpen ? 'rotate-180' : ''"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            x-show="servicesOpen"
            x-transition:enter="transition ease-out duration-150"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            class="pl-4 flex flex-col gap-1 pb-2"
            style="display: none;"
          >
            <a href="/services/clear-aligners" @click="mobileOpen = false"
               class="text-sm font-medium text-neutral-dark py-2 hover:text-brand-primary transition-all duration-200">
              Clear Aligners
            </a>
            <a href="/services/cosmetic-dentistry" @click="mobileOpen = false"
               class="text-sm font-medium text-neutral-dark py-2 hover:text-brand-primary transition-all duration-200">
              Cosmetic Dentistry
            </a>
            <a href="/services/deep-cleaning" @click="mobileOpen = false"
               class="text-sm font-medium text-neutral-dark py-2 hover:text-brand-primary transition-all duration-200">
              Deep Cleaning
            </a>
            <a href="/services/dental-bonding" @click="mobileOpen = false"
               class="text-sm font-medium text-neutral-dark py-2 hover:text-brand-primary transition-all duration-200">
              Dental Bonding
            </a>
            <a href="/services/dental-bridges" @click="mobileOpen = false"
               class="text-sm font-medium text-neutral-dark py-2 hover:text-brand-primary transition-all duration-200">
              Dental Bridges
            </a>
            <a href="/services/dental-crowns" @click="mobileOpen = false"
               class="text-sm font-medium text-neutral-dark py-2 hover:text-brand-primary transition-all duration-200">
              Dental Crowns
            </a>
            <a href="/services" @click="mobileOpen = false"
               class="text-sm font-semibold text-brand-primary py-2 hover:underline transition-all duration-200">
              All Services →
            </a>
          </div>
        </div>

        <div class="border-t border-neutral-100"></div>

        <a href="/blog" @click="mobileOpen = false"
           class="text-sm font-semibold text-neutral-dark py-3 hover:text-brand-primary transition-all duration-200">
          Our Blog
        </a>
        <a href="/schedule" @click="mobileOpen = false"
           class="text-sm font-semibold text-neutral-dark py-3 hover:text-brand-primary transition-all duration-200">
          New Patients
        </a>
        <a href="/about" @click="mobileOpen = false"
           class="text-sm font-semibold text-neutral-dark py-3 hover:text-brand-primary transition-all duration-200">
          Meet Dr. Hoang
        </a>

        <div class="border-t border-neutral-100 mt-2 pt-4 flex flex-col gap-3">
          <a
            href="tel:+15624208578"
            class="text-sm font-semibold tabular-nums text-neutral-dark hover:text-brand-primary transition-all duration-200 py-1"
            aria-label="Call Spring St. Dentistry at (562) 420-8578"
          >
            (562) 420-8578
          </a>
          <a
            href="/schedule"
            class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-2xl transition-all duration-200 text-center hover:opacity-90"
            @click="mobileOpen = false"
          >
            Book Appointment
          </a>
        </div>
      </div>
    </div>

  </nav>
</header>