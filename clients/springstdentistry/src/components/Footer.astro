---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'



const currentYear = new Date().getFullYear()

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Blog', href: '/blog' },
  { label: 'Schedule', href: '/schedule' },
]

const socialLinks = [
  {
    label: 'Google Reviews',
    href: 'https://www.google.com/maps/place/Spring+St.+Dentistry/@33.766568,-118.0842986,13z/data=!4m6!3m5!1s0x80dd2e06b18264df:0x5859cb8cd370dcb8!8m2!3d33.8097103!4d-118.1057071!16s%2Fg%2F1tx1thg9?entry=ttu',
    icon: 'google',
  },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/SpringStDentistry',
    icon: 'facebook',
  },
]
---

<footer class="w-full bg-neutral-dark text-white">

  <!-- Editorial split: large practice name left, columns right -->
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Left column: practice identity -->
      <div class="flex flex-col gap-6">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary">
          Long Beach, CA
        </p>
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-white">
          {site.name}
        </h2>
        <p class="text-base leading-relaxed text-neutral-300 max-w-sm">
          Neighborhood dentistry rooted in Spring Street — where honest care and unhurried appointments have been the standard since day one.
        </p>

        <!-- Address block -->
        <address class="not-italic flex flex-col gap-1 text-sm text-neutral-300">
          <span>{addr.street}</span>
          <span>{addr.city}, {addr.state} {addr.zip}</span>
          <a
            href={`tel:${site.phone.replace(/\D/g, '')}`}
            class="mt-2 text-brand-primary font-semibold text-base hover:underline underline-offset-2 transition-all duration-200"
            aria-label={`Call us at ${site.phone}`}
          >
            {site.phone}
          </a>
        </address>

        <!-- Social links -->
        <div class="flex items-center gap-4 mt-2">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="inline-flex items-center gap-2 text-sm font-medium text-neutral-300 hover:text-brand-primary transition-all duration-200"
            >
              {link.icon === 'google' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M21.805 10.023H12v3.977h5.617C17.1 16.018 14.78 17.5 12 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5c1.395 0 2.663.522 3.627 1.373l2.828-2.828C16.738 3.358 14.48 2.5 12 2.5 6.753 2.5 2.5 6.753 2.5 12S6.753 21.5 12 21.5c5.523 0 9.5-3.977 9.5-9.5 0-.655-.067-1.295-.195-1.977z"/>
                </svg>
              )}
              {link.icon === 'facebook' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22 12c0-5.522-4.478-10-10-10S2 6.478 2 12c0 4.991 3.657 9.128 8.438 9.878V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
              )}
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Right column: nav + hours -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">

        <!-- Navigation -->
        <nav aria-label="Footer navigation">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary mb-4">
            Navigation
          </p>
          <ul class="flex flex-col gap-3">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-base text-neutral-300 hover:text-white transition-all duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Office hours -->
        {site.hours && (
          <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary mb-4">
              Office Hours
            </p>
            <ul class="flex flex-col gap-2">
              {Object.entries(site.hours).map(([day, hours]) => (
                <li class="flex justify-between gap-4 text-sm text-neutral-300">
                  <span class="font-medium text-white">{day}</span>
                  <span>{hours}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-neutral-400">
        &copy; {currentYear} {site.name}. All rights reserved.
      </p>
      <p class="text-sm text-neutral-500">
        {addr.city}, {addr.state}
      </p>
    </div>
  </div>

</footer>