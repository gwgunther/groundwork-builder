---
import { site, doctor, address as addr } from '../config/site'
import { designDNA } from '../config/design-dna'


---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-200">
  <nav
    class="max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between h-16"
    aria-label="Main navigation"
    x-data="{ mobileOpen: false }"
  >

    <!-- Logo / Practice Name -->
    <a
      href="/"
      class="flex-shrink-0 font-serif text-xl font-bold tracking-tight text-neutral-dark hover:opacity-80 transition-all duration-200 whitespace-nowrap"
      aria-label="Chang Orthodontics — home"
    >
      Chang Orthodontics
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">

      <!-- Meet Chang -->
      <a
        href="/about"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      >
        Meet Chang
      </a>

      <!-- Services Dropdown -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg
            class="w-3.5 h-3.5 mt-px transition-transform duration-200 group-hover:rotate-180"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Dropdown — pt-2 bridges hover gap, never mt-2 -->
        <div class="absolute top-full left-0 pt-2 w-64 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150">
          <div class="bg-white shadow-lg rounded-2xl border border-neutral-200 py-2 overflow-hidden">
            <a
              href="/services/cleft-lip-and-palate-treatment"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:text-brand-primary hover:bg-neutral-50 transition-all duration-150 whitespace-nowrap"
            >
              Cleft Lip and Palate Treatment
            </a>
            <a
              href="/services/craniofacial-orthodontics"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:text-brand-primary hover:bg-neutral-50 transition-all duration-150 whitespace-nowrap"
            >
              Craniofacial Orthodontics
            </a>
            <a
              href="/services/damon-smile"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:text-brand-primary hover:bg-neutral-50 transition-all duration-150 whitespace-nowrap"
            >
              Damon Smile
            </a>
            <a
              href="/services/dentofacial-orthopedics"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:text-brand-primary hover:bg-neutral-50 transition-all duration-150 whitespace-nowrap"
            >
              Dentofacial Orthopedics
            </a>
            <a
              href="/services/digital-x-rays"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:text-brand-primary hover:bg-neutral-50 transition-all duration-150 whitespace-nowrap"
            >
              Digital X-rays
            </a>
            <a
              href="/services/early-orthodontic-treatment"
              class="block px-4 py-2.5 text-sm text-neutral-700 hover:text-brand-primary hover:bg-neutral-50 transition-all duration-150 whitespace-nowrap"
            >
              Early Orthodontic Treatment
            </a>
            <div class="border-t border-neutral-100 mt-1 pt-1">
              <a
                href="/services"
                class="block px-4 py-2.5 text-sm font-semibold text-brand-primary hover:bg-neutral-50 transition-all duration-150 whitespace-nowrap"
              >
                All Services →
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Gallery -->
      <a
        href="/gallery"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      >
        Gallery
      </a>

      <!-- FAQ -->
      <a
        href="/faq"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      >
        FAQ
      </a>

      <!-- Financing -->
      <a
        href="/financing"
        class="text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap"
      >
        Financing
      </a>

    </div>

    <!-- Desktop Right: Phone + CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="tel:+15624300541"
        class="tabular-nums text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 whitespace-nowrap min-h-[44px] flex items-center"
        aria-label="Call Chang Orthodontics at (562) 430-0541"
      >
        (562) 430-0541
      </a>
      <a
        href="/schedule"
        class="ml-6 inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-2xl transition-all duration-200 text-center hover:opacity-90 whitespace-nowrap"
      >
        Book Appointment
      </a>
    </div>

    <!-- Mobile: Phone + Hamburger -->
    <div class="flex md:hidden items-center gap-3">
      <a
        href="tel:+15624300541"
        class="tabular-nums text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 min-h-[44px] min-w-[44px] flex items-center"
        aria-label="Call Chang Orthodontics at (562) 430-0541"
      >
        (562) 430-0541
      </a>
      <button
        type="button"
        class="min-h-[44px] min-w-[44px] flex items-center justify-center text-neutral-700 hover:text-brand-primary transition-all duration-200"
        @click="mobileOpen = !mobileOpen"
        :aria-expanded="mobileOpen.toString()"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg
          x-show="!mobileOpen"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg
          x-show="mobileOpen"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden border-t border-neutral-200 bg-white"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1">

      <a
        href="/about"
        class="block py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border-b border-neutral-100"
        @click="mobileOpen = false"
      >
        Meet Chang
      </a>

      <!-- Mobile Services Accordion -->
      <div x-data="{ servicesOpen: false }">
        <button
          type="button"
          class="w-full flex items-center justify-between py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border-b border-neutral-100"
          @click="servicesOpen = !servicesOpen"
          :aria-expanded="servicesOpen.toString()"
        >
          Services
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200"
            :class="servicesOpen ? 'rotate-180' : ''"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div
          x-show="servicesOpen"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          class="pl-4 flex flex-col gap-0"
        >
          <a
            href="/services/cleft-lip-and-palate-treatment"
            class="block py-2.5 text-sm text-neutral-700 hover:text-brand-primary transition-all duration-150"
            @click="mobileOpen = false"
          >
            Cleft Lip and Palate Treatment
          </a>
          <a
            href="/services/craniofacial-orthodontics"
            class="block py-2.5 text-sm text-neutral-700 hover:text-brand-primary transition-all duration-150"
            @click="mobileOpen = false"
          >
            Craniofacial Orthodontics
          </a>
          <a
            href="/services/damon-smile"
            class="block py-2.5 text-sm text-neutral-700 hover:text-brand-primary transition-all duration-150"
            @click="mobileOpen = false"
          >
            Damon Smile
          </a>
          <a
            href="/services/dentofacial-orthopedics"
            class="block py-2.5 text-sm text-neutral-700 hover:text-brand-primary transition-all duration-150"
            @click="mobileOpen = false"
          >
            Dentofacial Orthopedics
          </a>
          <a
            href="/services/digital-x-rays"
            class="block py-2.5 text-sm text-neutral-700 hover:text-brand-primary transition-all duration-150"
            @click="mobileOpen = false"
          >
            Digital X-rays
          </a>
          <a
            href="/services/early-orthodontic-treatment"
            class="block py-2.5 text-sm text-neutral-700 hover:text-brand-primary transition-all duration-150"
            @click="mobileOpen = false"
          >
            Early Orthodontic Treatment
          </a>
          <a
            href="/services"
            class="block py-2.5 text-sm font-semibold text-brand-primary hover:opacity-80 transition-all duration-150"
            @click="mobileOpen = false"
          >
            All Services →
          </a>
        </div>
      </div>

      <a
        href="/gallery"
        class="block py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border-b border-neutral-100"
        @click="mobileOpen = false"
      >
        Gallery
      </a>

      <a
        href="/faq"
        class="block py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border-b border-neutral-100"
        @click="mobileOpen = false"
      >
        FAQ
      </a>

      <a
        href="/financing"
        class="block py-3 text-sm font-semibold text-neutral-700 hover:text-brand-primary transition-all duration-200 border-b border-neutral-100"
        @click="mobileOpen = false"
      >
        Financing
      </a>

      <div class="pt-3 pb-2">
        <a
          href="/schedule"
          class="inline-block w-full bg-brand-primary text-white font-semibold px-6 py-3 rounded-2xl transition-all duration-200 text-center hover:opacity-90"
          @click="mobileOpen = false"
        >
          Book Appointment
        </a>
      </div>

    </div>
  </div>

</header>