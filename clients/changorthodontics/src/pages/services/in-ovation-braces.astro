---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "In-Ovation® Braces",
  "description": "A technically advanced self-ligating braces system for faster results and greater comfort.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`In-Ovation Braces Los Alamitos | ${site.name}`}
  description="A technically advanced self-ligating braces system for faster results and greater comfort."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      In-Ovation® Braces
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      A technically advanced self-ligating braces system for faster results and greater comfort.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">In-Ovation is a technically advanced system that can give you the radiant smile you have always wanted more quickly than traditional braces, and without the need for elastic ties. In-Ovation's self-ligating bracket design reduces friction on the archwire, which can mean less discomfort between appointments and fewer adjustment visits over the course of treatment. Our office is pleased to offer In-Ovation System braces as part of our comprehensive braces menu.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
