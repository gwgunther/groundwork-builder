---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Types of Appliances",
  "description": "Orthodontic appliances used to guide jaw development, correct bite relationships, and support comprehensive treatment.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Types of Appliances Los Alamitos | ${site.name}`}
  description="Orthodontic appliances used to guide jaw development, correct bite relationships, and support comprehensive treatment."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Types of Appliances
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Orthodontic appliances used to guide jaw development, correct bite relationships, and support comprehensive treatment.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Orthodontic appliances are devices used alongside or in place of braces to address skeletal and dental discrepancies that tooth movement alone cannot resolve. Chang Orthodontics utilizes a range of appliances — including elastics, the Forsus Fatigue Resistant Device, headgear, the Herbst® Appliance, palatal expanders, positioners, retainers, separators, and the Twin Block Appliance — each selected based on the specific clinical needs of the patient. Your treatment plan will specify which appliances are indicated and provide clear instructions for wear and care.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
