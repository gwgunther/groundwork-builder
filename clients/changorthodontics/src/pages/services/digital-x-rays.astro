---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Digital X-rays",
  "description": "Advanced digital imaging that reduces radiation exposure and improves diagnostic clarity.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Digital X-rays Los Alamitos | ${site.name}`}
  description="Advanced digital imaging that reduces radiation exposure and improves diagnostic clarity."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Digital X-rays
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Advanced digital imaging that reduces radiation exposure and improves diagnostic clarity.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Using the most advanced orthodontic technology possible is just as important as staying up-to-date on the latest treatment techniques. Because our practice is dedicated to providing you with the safest and most convenient treatment options available, we use digital X-rays. Digital X-rays provide several advanced imaging options designed to save time, provide clearer dental photos, and expose patients to less radiation than traditional X-ray technology.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
