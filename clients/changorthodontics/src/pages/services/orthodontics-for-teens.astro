---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Orthodontics for Teens",
  "description": "Braces and clear aligner options tailored to the unique clinical and lifestyle needs of adolescent patients.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Orthodontics for Teens Los Alamitos | ${site.name}`}
  description="Braces and clear aligner options tailored to the unique clinical and lifestyle needs of adolescent patients."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Orthodontics for Teens
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Braces and clear aligner options tailored to the unique clinical and lifestyle needs of adolescent patients.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">The teenage years are the most common time for comprehensive orthodontic treatment, as the permanent dentition is largely in place and jaw growth can still be guided effectively. Chang Orthodontics offers teens a full range of treatment options — including traditional metal braces, Damon self-ligating braces, In-Ovation braces, and Invisalign for Teens — so treatment can be matched to each patient's clinical needs and personal preferences. Our team is experienced in managing the full spectrum of adolescent malocclusions, and an initial consultation will determine which approach is right for your teenager.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
