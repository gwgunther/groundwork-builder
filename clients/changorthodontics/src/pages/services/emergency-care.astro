---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Emergency Care",
  "description": "Guidance for managing common orthodontic urgencies between scheduled appointments.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Emergency Care Los Alamitos | ${site.name}`}
  description="Guidance for managing common orthodontic urgencies between scheduled appointments."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Emergency Care
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Guidance for managing common orthodontic urgencies between scheduled appointments.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Most orthodontic discomforts can be managed at home until your next scheduled visit. Common issues such as general soreness, a loose bracket, a poking wire, or a loose appliance each have straightforward interim solutions. If you are experiencing an orthodontic urgency — including a loose or broken appliance, a wire causing irritation, or unexpected discomfort — contact our office directly so we can advise you on next steps or schedule prompt attention. For immediate assistance, please call or text (562) 430-0541.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Contact Our Office</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
