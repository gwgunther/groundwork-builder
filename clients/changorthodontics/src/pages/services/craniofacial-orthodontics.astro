  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Craniofacial Orthodontics",
  "description": "A sub-specialty of orthodontics focused on patients with craniofacial birth defects, including cleft lip and palate.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
