---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Orthodontics for Adults",
  "description": "Comprehensive orthodontic treatment options designed for adult patients at every stage of life.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Orthodontics for Adults Los Alamitos | ${site.name}`}
  description="Comprehensive orthodontic treatment options designed for adult patients at every stage of life."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Orthodontics for Adults
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Comprehensive orthodontic treatment options designed for adult patients at every stage of life.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Orthodontic treatment is not limited to adolescence. Adults of all ages seek treatment to correct long-standing malocclusions, address shifting that occurred after prior treatment, or improve function and aesthetics. Chang Orthodontics offers a full range of adult treatment options — including Invisalign clear aligners, Damon self-ligating braces, In-Ovation braces, and SureSmile — supported by digital impressions and advanced imaging technology. An initial consultation will identify which approach best suits your clinical needs and lifestyle.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
