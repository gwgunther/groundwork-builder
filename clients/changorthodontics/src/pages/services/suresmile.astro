---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "SureSmile®",
  "description": "Shorter treatments, fewer office visits, and less discomfort through computer-driven archwire technology.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`SureSmile Los Alamitos | ${site.name}`}
  description="Shorter treatments, fewer office visits, and less discomfort through computer-driven archwire technology."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      SureSmile®
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Shorter treatments, fewer office visits, and less discomfort through computer-driven archwire technology.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Through the use of SureSmile technology, your orthodontist can offer you a braces experience designed to deliver more precise tooth movement in less time. SureSmile uses 3D imaging and robotic archwire fabrication to customize each wire to your individual treatment plan, reducing the number of adjustments needed and the overall duration of active treatment. Clinical data based on a comparison of patients treated conventionally versus patients treated with SureSmile supports measurable reductions in treatment time.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
