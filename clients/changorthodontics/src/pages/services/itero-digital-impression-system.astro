---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "iTero® Digital Impression System",
  "description": "Highly accurate digital impressions with no trays, no material, and no discomfort.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`iTero Digital Impression System Los Alamitos | ${site.name}`}
  description="Highly accurate digital impressions with no trays, no material, and no discomfort."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      iTero® Digital Impression System
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Highly accurate digital impressions with no trays, no material, and no discomfort.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">No more goop, gagging, or discomfort. Using an iTero scanner, your orthodontist can take a highly accurate digital impression of your teeth and jaw. The new technology completely eliminates the tray and impression material used in conventional impressions. The iTero scanner digitally captures the structure of the teeth and gums using the latest optical technology via a compact, hand-held wand. Digital impressions integrate directly with Invisalign treatment planning, enabling precise aligner fabrication and an outcome simulation you can review before committing to treatment.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
