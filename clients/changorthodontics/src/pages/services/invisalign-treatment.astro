---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Invisalign® Treatment",
  "description": "Certified Invisalign provider in Los Alamitos — clear aligner treatment integrated with iTero digital impressions.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Invisalign Treatment Los Alamitos | ${site.name}`}
  description="Certified Invisalign provider in Los Alamitos — clear aligner treatment integrated with iTero digital impressions."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Invisalign® Treatment
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Certified Invisalign provider in Los Alamitos — clear aligner treatment integrated with iTero digital impressions.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">There's never been a better time to straighten your teeth with the most advanced clear aligner in the world. Our office is proud to be a certified provider of Invisalign clear aligners, which give you the flexibility to remove your aligners for eating, brushing, and flossing. At your initial consultation, we will discuss your orthodontic needs and evaluate whether Invisalign treatment is right for you. Treatment planning at our office is supported by the iTero Digital Impression System, eliminating traditional impression trays and allowing us to show you a digital preview of your projected outcome before treatment begins.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
