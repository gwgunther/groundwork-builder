---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Surgical Orthodontics",
  "description": "Orthognathic surgery coordinated with orthodontic treatment for skeletal discrepancies beyond the range of braces alone.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Surgical Orthodontics Los Alamitos | ${site.name}`}
  description="Orthognathic surgery coordinated with orthodontic treatment for skeletal discrepancies beyond the range of braces alone."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Surgical Orthodontics
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Orthognathic surgery coordinated with orthodontic treatment for skeletal discrepancies beyond the range of braces alone.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Orthognathic surgery, also known as corrective jaw surgery or surgical orthodontics, is a specialized treatment used to improve the alignment and function of the jaws. While orthodontic treatment can correct many bite problems by moving the teeth, some skeletal discrepancies require repositioning the jaw bones surgically to achieve a stable, functional, and aesthetic result. Orthognathic surgery can improve oral health, facial balance, chewing ability, speech, breathing, and overall comfort. Dr. Russell Chang's Master of Science degree in Cranial Facial Biology from Northwestern University provides the clinical foundation for managing complex surgical orthodontic cases in coordination with oral and maxillofacial surgeons.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
