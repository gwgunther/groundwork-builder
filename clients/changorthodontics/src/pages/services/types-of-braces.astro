---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Types of Braces",
  "description": "A full range of braces options to match each patient's clinical needs and preferences.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Types of Braces Los Alamitos | ${site.name}`}
  description="A full range of braces options to match each patient's clinical needs and preferences."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Types of Braces
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      A full range of braces options to match each patient's clinical needs and preferences.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">Chang Orthodontics offers multiple braces systems so that treatment can be tailored to each patient's clinical requirements and personal preferences. Traditional metal braces are the most common type and are more comfortable today than ever before — made of high-grade stainless steel, they straighten teeth using metal brackets and archwires. Self-ligating braces use the same materials but eliminate the need for elastics, reducing friction and requiring fewer adjustments. Our practice also offers Damon Smile passive self-ligating braces and In-Ovation braces, each with distinct clinical advantages. Clear and ceramic bracket options are available for patients who prefer a less visible appliance.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
