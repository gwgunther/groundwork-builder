---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, localBusinessSchema } from '../../config/site';

const procedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Orthodontics for Children",
  "description": "Early evaluation and timely intervention to guide proper dental and jaw development.",
  "procedureType": "https://schema.org/Therapeutic",
  "provider": {
    "@type": "Dentist",
    "name": "Chang Orthodontics",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Alamitos"
    }
  }
};
---

<BaseLayout
  title={`Orthodontics for Children Los Alamitos | ${site.name}`}
  description="Early evaluation and timely intervention to guide proper dental and jaw development."
  schema={[localBusinessSchema, procedureSchema]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-4">
      <a href="/services" class="hover:underline">Services</a>
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-neutral-dark mb-4 leading-tight">
      Orthodontics for Children
    </h1>
    <p class="text-xl text-neutral-mid mb-8 leading-relaxed">
      Early evaluation and timely intervention to guide proper dental and jaw development.
    </p>
    <div class="prose prose-lg max-w-none text-neutral-mid leading-relaxed">
      <p class="mb-4">While there is no exact age for children to begin orthodontic treatment, the American Association of Orthodontists recommends visiting the orthodontist around age seven. By this age, most children have a mix of baby teeth and adult teeth, making it easier for the orthodontist to diagnose and correct tooth and jaw problems sooner and without surgery. An early evaluation does not necessarily mean early treatment — it means the orthodontist can monitor development and intervene at the optimal time for each child.</p>
      
    </div>
    <div class="mt-10 flex gap-4 flex-wrap">
      <a href="/schedule" class="btn-primary">Schedule a Consultation</a>
      <a href="/services" class="btn-secondary">View All Services</a>
    </div>
  </div>
</BaseLayout>
