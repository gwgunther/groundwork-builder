---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import { site, localBusinessSchema } from '../config/site';

// TODO: Customize services for the practice
const services = [
  { name: 'Cleft Lip and Palate Treatment', slug: 'cleft-lip-and-palate-treatment', href: '/services/cleft-lip-and-palate-treatment', desc: 'Specialized orthodontic care for patients with cleft lip and palate, coordinated within a multidisciplinary craniofacial team.' },
  { name: 'Craniofacial Orthodontics', slug: 'craniofacial-orthodontics', href: '/services/craniofacial-orthodontics', desc: 'A sub-specialty of orthodontics focused on patients with craniofacial birth defects, including cleft lip and palate.' },
  { name: 'Damon Smile', slug: 'damon-smile', href: '/services/damon-smile', desc: 'Passive self-ligating braces designed to reduce friction and pressure throughout treatment.' },
  { name: 'Dentofacial Orthopedics', slug: 'dentofacial-orthopedics', href: '/services/dentofacial-orthopedics', desc: 'Orthodontics and dentofacial orthopedics: understanding the full scope of Dr. Chang\'s specialty.' },
  { name: 'Digital X-rays', slug: 'digital-x-rays', href: '/services/digital-x-rays', desc: 'Advanced digital imaging that reduces radiation exposure and improves diagnostic clarity.' },
  { name: 'Early Orthodontic Treatment', slug: 'early-orthodontic-treatment', href: '/services/early-orthodontic-treatment', desc: 'Interceptive orthodontic evaluation starting at age seven, as recommended by the American Association of Orthodontists.' },
  { name: 'Emergency Care', slug: 'emergency-care', href: '/services/emergency-care', desc: 'Guidance for managing common orthodontic urgencies between scheduled appointments.' },
  { name: 'In-Ovation Braces', slug: 'in-ovation-braces', href: '/services/in-ovation-braces', desc: 'A technically advanced self-ligating braces system for faster results and greater comfort.' },
  { name: 'Invisalign Treatment', slug: 'invisalign-treatment', href: '/services/invisalign-treatment', desc: 'Certified Invisalign provider in Los Alamitos — clear aligner treatment integrated with iTero digital impressions.' },
  { name: 'iTero Digital Impression System', slug: 'itero-digital-impression-system', href: '/services/itero-digital-impression-system', desc: 'Highly accurate digital impressions with no trays, no material, and no discomfort.' },
  { name: 'Orthodontic Retention', slug: 'orthodontic-retention', href: '/services/orthodontic-retention', desc: 'Protecting your orthodontic results for the long term.' },
  { name: 'Orthodontics for Adults', slug: 'orthodontics-for-adults', href: '/services/orthodontics-for-adults', desc: 'Comprehensive orthodontic treatment options designed for adult patients at every stage of life.' },
  { name: 'Orthodontics for Children', slug: 'orthodontics-for-children', href: '/services/orthodontics-for-children', desc: 'Early evaluation and timely intervention to guide proper dental and jaw development.' },
  { name: 'Orthodontics for Teens', slug: 'orthodontics-for-teens', href: '/services/orthodontics-for-teens', desc: 'Braces and clear aligner options tailored to the unique clinical and lifestyle needs of adolescent patients.' },
  { name: 'SureSmile', slug: 'suresmile', href: '/services/suresmile', desc: 'Shorter treatments, fewer office visits, and less discomfort through computer-driven archwire technology.' },
  { name: 'Surgical Orthodontics', slug: 'surgical-orthodontics', href: '/services/surgical-orthodontics', desc: 'Orthognathic surgery coordinated with orthodontic treatment for skeletal discrepancies beyond the range of braces alone.' },
  { name: 'Types of Appliances', slug: 'types-of-appliances', href: '/services/types-of-appliances', desc: 'Orthodontic appliances used to guide jaw development, correct bite relationships, and support comprehensive treatment.' },
  { name: 'Types of Braces', slug: 'types-of-braces', href: '/services/types-of-braces', desc: 'A full range of braces options to match each patient\'s clinical needs and preferences.' },
];
---

<BaseLayout
  title={`Services — ${site.name}`}
  description={`Comprehensive dental services at ${site.name}. General dentistry, cosmetic treatments, dental implants, and restorations. Call ${site.phone}.`}
  schema={localBusinessSchema}
>
  <section class="bg-surface-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="section-heading mb-6">Our Services</h1>
        <p class="text-lg text-neutral-mid leading-relaxed">
          From routine checkups to advanced restorations, we provide a full range of dental services to keep your smile healthy and beautiful.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((service) => (
          <a href={service.href || `/services/${service.slug}`} class="card hover:border-brand-primary/30 transition-colors group">
            <h2 class="font-serif text-xl font-semibold text-neutral-dark mb-2 group-hover:text-brand-primary transition-colors">{service.name}</h2>
            <p class="text-neutral-mid">{service.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CTABlock phone={site.phone} />
    </div>
  </section>
</BaseLayout>
