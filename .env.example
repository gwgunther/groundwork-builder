# Anthropic API (for AI pipeline steps — site audit, copy strategy, etc.)
ANTHROPIC_API_KEY=

# Google Analytics 4
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: override the displayed phone with a Google Ads call-extension
# forwarding number (or any per-deployment number). Leave blank to use the
# real practice phone from src/config/site.ts. Schema (telephone) always
# keeps the real number for NAP-consistent local SEO.
PUBLIC_DISPLAY_PHONE=

# Google API (for automation scripts)
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json
GSC_SITE_URL=https://[DOMAIN]/
GA4_PROPERTY_ID=

# Google Business Profile (OAuth — for automation scripts)
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCESS_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Cloudflare — Pages deploy + D1 CRM (groundwork-ops)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PAGES_PROJECT=

# Pipeline caches live under _memory/ (runs.jsonl, library/, images/).
# Intake: --data intake.json OR --slug <slug> (D1 accounts.intake_json or clients/<slug>/intake.json).
#
# CRM is Cloudflare D1 (scripts/pipeline/lib/d1.js). Legacy Airtable env vars below
# are unused by the live pipeline; kept only for one-shot migrate-airtable-* scripts.
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# Legacy Supabase — only for one-shot historical export (npm run migrate:supabase):
# DATABASE_URL=postgresql://...

# Optional: default design-catalog reference for builds (id or "auto")
# GROUNDWORK_DEFAULT_REFERENCE=auto

# Optional: PageSpeed for Grade My Site / audits
# GOOGLE_PAGESPEED_API_KEY=
